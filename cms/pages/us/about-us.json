  "content": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"AboutPage\",\n  \"inLanguage\": \"en\",\n  \"name\": \"About MOMUTO — Custom Soccer Kits for Amateur Teams\",\n  \"description\": \"MOMUTO is a European custom soccer kit brand, founded in 2023, bringing professional-grade dye-sublimation jerseys to amateur teams worldwide. No middlemen, no peeling badges, no minimum order. Delivered in 25-30 days worldwide.\",\n  \"url\": \"/pages/about-us\",\n  \"mainEntity\": {\n    \"@type\": \"Organization\",\n    \"name\": \"MOMUTO\",\n    \"url\": \"/\",\n    \"foundingDate\": \"2023\",\n    \"description\": \"Custom soccer kit manufacturer specializing in full dye-sublimation printing for amateur soccer teams. European design, global production, zero middlemen.\",\n    \"brand\": { \"@type\": \"Brand\", \"name\": \"MOMUTO\" },\n    \"areaServed\": \"Worldwide\",\n    \"knowsAbout\": [\n      \"Custom soccer kits\",\n      \"Dye sublimation printing\",\n      \"Polyester-elastane performance fabrics\",\n      \"Soccer kit design\",\n      \"Concept soccer jerseys\"\n    ],\n    \"makesOffer\": {\n      \"@type\": \"Offer\",\n      \"name\": \"MOMUTO Custom Soccer Kit\",\n      \"priceCurrency\": \"USD\",\n      \"price\": \"21.90\",\n      \"priceSpecification\": {\n        \"@type\": \"UnitPriceSpecification\",\n        \"price\": \"21.90\",\n        \"priceCurrency\": \"USD\",\n        \"referenceQuantity\": { \"@type\": \"QuantitativeValue\", \"value\": \"10\", \"unitCode\": \"C62\" },\n        \"description\": \"From $25.90 per jersey for orders of 10+ units. $45.90 for a single jersey. Delivered in 25-30 days worldwide.\"\n      }\n    }\n  }\n}\n</script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\" />\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Outfit:wght@300;400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\" />\n<style>\n    :root {\n        --mg-bg: #ffffff;\n        --mg-surface: #fafafa;\n        --mg-text: #0a0a0a;\n        --mg-muted: #52525b;\n        --mg-dim: #71717a;\n        --mg-border: #e4e4e7;\n        --mg-red: #c8352e;\n        --mg-red-hover: #a82a24;\n        --font-display: 'Bebas Neue', sans-serif;\n        --font-body: 'Outfit', sans-serif;\n    }\n\n    /* Hide the CMS-rendered page title (the site layout injects it as\n       .title above our custom hero — this selector is intentionally\n       unscoped because .title is a sibling of .about-page, not a child). */\n    .title { display: none; }\n\n    .about-page { font-family: var(--font-body); color: var(--mg-text); background: var(--mg-bg); line-height: 1.6; }\n    .about-page * { box-sizing: border-box; }\n\n    .about-container { width: 90%; max-width: 1200px; margin: 0 auto; padding: 2.5rem 0 4rem; }\n\n    /* Hero */\n    .about-hero { display: flex; align-items: center; gap: 3rem; padding: 2rem 0 4rem; margin-bottom: 3rem; border-bottom: 1px solid var(--mg-border); }\n    .about-hero > * { flex: 1; min-width: 0; }\n    .hero-kicker { display: inline-block; font-family: var(--font-display); font-size: 1rem; letter-spacing: 0.25em; color: var(--mg-red); margin: 0 0 1.25rem; text-transform: uppercase; }\n    .hero-title { font-family: var(--font-display); font-size: clamp(2.75rem, 7vw, 5.25rem); line-height: 0.95; letter-spacing: 0.01em; margin: 0 0 1.5rem; text-transform: uppercase; color: var(--mg-text); font-weight: 400; }\n    .hero-lead { font-size: 1.1875rem; line-height: 1.55; margin: 0 0 1rem; font-weight: 500; color: var(--mg-text); max-width: 52ch; }\n    .hero-body { font-size: 1rem; line-height: 1.65; color: var(--mg-muted); margin: 0; max-width: 52ch; }\n    .hero-image img { width: 100%; height: auto; display: block; border-radius: 6px; }\n\n    /* Feature sections */\n    .about-feature { display: flex; align-items: center; gap: 3rem; margin-bottom: 4rem; }\n    .about-feature > * { flex: 1; min-width: 0; }\n    .feature-title { font-family: var(--font-display); font-size: clamp(1.875rem, 4.25vw, 2.75rem); line-height: 1; letter-spacing: 0.01em; text-transform: uppercase; margin: 0 0 1.25rem; color: var(--mg-text); font-weight: 400; }\n    .feature-lead { font-size: 1.125rem; line-height: 1.5; margin: 0 0 1rem; font-weight: 500; color: var(--mg-text); }\n    .feature-body { font-size: 1rem; line-height: 1.65; margin: 0 0 0.75rem; color: var(--mg-muted); }\n    .feature-body strong, .feature-lead strong { color: var(--mg-text); font-weight: 600; }\n    .feature-list { list-style: none; padding: 0; margin: 1.25rem 0 0; }\n    .feature-list li { font-size: 1rem; line-height: 1.6; padding: 0 0 0 1.5rem; margin: 0 0 0.75rem; color: var(--mg-muted); position: relative; }\n    .feature-list li::before { content: \"\"; position: absolute; left: 0; top: 0.7rem; width: 0.875rem; height: 2px; background: var(--mg-red); }\n    .feature-list strong { color: var(--mg-text); font-weight: 600; }\n    .feature-image img { width: 100%; height: auto; display: block; border-radius: 6px; }\n\n    /* CTA */\n    .about-cta { text-align: center; padding: 4rem 0 2rem; border-top: 1px solid var(--mg-border); margin-top: 2rem; }\n    .cta-title { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; letter-spacing: 0.01em; text-transform: uppercase; margin: 0 auto 1rem; max-width: 22ch; color: var(--mg-text); font-weight: 400; }\n    .cta-sub { font-size: 1.0625rem; color: var(--mg-muted); margin: 0 0 2rem; }\n    .cta-sub strong { color: var(--mg-text); font-weight: 600; }\n    .cta-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }\n\n    /* Buttons */\n    .btn { display: inline-block; padding: 1rem 2rem; font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-radius: 4px; border: 2px solid var(--mg-text); transition: background-color 0.2s, color 0.2s, border-color 0.2s; cursor: pointer; }\n    .btn-primary { background: var(--mg-text); color: #ffffff; }\n    .btn-primary:hover { background: var(--mg-red); border-color: var(--mg-red); color: #ffffff; }\n    .btn-secondary { background: transparent; color: var(--mg-text); }\n    .btn-secondary:hover { background: var(--mg-text); color: #ffffff; }\n\n    @media (max-width: 820px) {\n        .about-container { padding: 1.5rem 0 3rem; }\n        .about-hero, .about-feature { flex-direction: column; gap: 1.5rem; }\n        .about-hero { padding: 1.5rem 0 2.5rem; margin-bottom: 2rem; }\n        .about-feature { margin-bottom: 2.5rem; }\n        .about-hero .hero-image, .about-feature .feature-image { order: -1; }\n        .about-cta { padding: 3rem 0 1rem; }\n        .cta-buttons { flex-direction: column; align-items: center; }\n        .btn { width: 100%; max-width: 320px; text-align: center; }\n    }\n</style>\n<div class=\"about-page\">\n<div class=\"about-container\">\n<section class=\"about-hero\">\n<div class=\"hero-copy\">\n<span class=\"hero-kicker\">About MOMUTO</span>\n<h1 class=\"hero-title\">Your identity, unlimited.</h1>\n<p class=\"hero-lead\">In a soccer world saturated with generic templates, <strong>MOMUTO</strong> gives you back control. Born in late 2023 with a clear mission: <strong>bringing professional quality to amateur teams.</strong></p>\n<p class=\"hero-body\">No middlemen. No peeling vinyl. Only exclusive design and elite performance.</p>\n</div>\n<div class=\"hero-image\"><img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20240503/26dee47be03339e58b60705a3bcbcc89.jpg\" alt=\"MOMUTO custom football team celebration\" /></div>\n</section>\n<section class=\"about-feature\">\n<div class=\"feature-image\"><img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20240503/2403e399289c69b71fc4fcf32cf916b3.jpg\" alt=\"MOMUTO dye-sublimation fabric detail\" /></div>\n<div class=\"feature-copy\">\n<h2 class=\"feature-title\">Your badge, forever</h2>\n<p class=\"feature-lead\"><strong>We know the pain of seeing your club badge peel off after three washes.</strong></p>\n<p class=\"feature-body\">That is why at <strong>MOMUTO</strong> we have eliminated traditional iron-on vinyl. We use <strong>full-fusion digital printing (dye sublimation)</strong>.</p>\n<ul class=\"feature-list\">\n<li><strong>Fusion, not adhesive:</strong> your design is not <em>on</em> the fabric, it <em>becomes</em> the fabric.</li>\n<li><strong>Total durability:</strong> pull, wash, play in mud — your identity stays intact from the first whistle to the post-match pint.</li>\n<li><strong>Future-proof squads:</strong> we keep your design on file forever. New player next season? Order a single jersey with no hassle.</li>\n</ul>\n</div>\n</section>\n<section class=\"about-feature\">\n<div class=\"feature-copy\">\n<h2 class=\"feature-title\">European design, global power</h2>\n<p class=\"feature-lead\">At <strong>MOMUTO</strong> we have no borders. Our creative headquarters breathes soccer in Europe, while our production travels to the epicenter of textile technology: <strong>Asia</strong>.</p>\n<p class=\"feature-body\">We manufacture where the industry giants do, ensuring access to the same technical fabrics and manufacturing precision — while <strong>eliminating the middlemen</strong> that inflate prices.</p>\n<p class=\"feature-body\">The result: <strong>Champions League quality at grassroots pricing.</strong></p>\n</div>\n<div class=\"feature-image\"><img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20240503/7107b9785aee3764865b3866b5d49d24.jpg\" alt=\"MOMUTO global manufacturing\" /></div>\n</section>\n<section class=\"about-feature\">\n<div class=\"feature-image\"><img src=\"https://cdn.staticsoe.com/uploads/52561/cart/resources/20251212/b9aa3125986f34f15a71fd6ae9a28f1e.jpg\" alt=\"MOMUTO Vitruvian Man concept football jersey\" /></div>\n<div class=\"feature-copy\">\n<h2 class=\"feature-title\">Soccer &amp; culture</h2>\n<p class=\"feature-lead\">We don't just dress players. We dress fans.</p>\n<p class=\"feature-body\">Our <strong>Concept Kits</strong> reimagine soccer and soccer history by fusing streetwear with sporting heritage. Designs that tell stories, built to be worn on the field and in the streets.</p>\n</div>\n</section>\n<section class=\"about-cta\">\n<h2 class=\"cta-title\">Don't play in someone else's kit. Create your own.</h2>\n<p class=\"cta-sub\">You have two ways to start your legacy with <strong>MOMUTO</strong>.</p>\n<div class=\"cta-buttons\"><a class=\"btn btn-primary\" href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=446703ab1ed3128104&amp;configId=ypi9qc1z&amp;suitName=mamuto3suit1&amp;lang=en&amp;langguage=en\">Open 3D configurator</a> <a class=\"btn btn-secondary\" href=\"/pages/request-custom-kit-design\">Request free design</a></div>\n</section>\n</div>\n</div>",
