rd-img-wrap\">\n                    <img src=\"https://cdn.staticsoe.com/pics/2572b5c39f8cbcf5e4d530fcfd8f86e55c1e969b7c9d95088180fb508e6c54b6.png\" alt=\"Custom soccer uniform — Pecados Capitales Duality\" class=\"trust-card-img\" loading=\"lazy\">\n                    <div class=\"trust-card-overlay\">\n                        <div class=\"trust-card-team\">PECADOS CAPITALES</div>\n                        <div class=\"trust-card-desc\">Duality. Angels &amp; demons in red, black &amp; gold.</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"trust-cta\">\n            <a href=\"/pages/request-custom-kit-design\" class=\"trust-btn-primary\">Request a Custom Design</a>\n            <a href=\"/pages/custom-kit-gallery\" class=\"trust-btn-secondary\">Explore 500+ Custom Soccer Jersey Designs →</a>\n        </div>\n    </div>\n</section>\n<!-- CTA -->\n<div class=\"sj-cta-block\">\n<h2>Kit Out Your Club</h2>\n<p>Tell us about your team and get a professional design back in 1&ndash;2 days &mdash; a $15 deposit applies, fully credited to orders of 5+ jerseys.</p>\n<a href=\"/pages/request-custom-kit-design\" class=\"sj-btn\">Request a Custom Design</a> <a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&amp;configId=ypi9qc1z&amp;suitName=mamuto3suit1&amp;lang=en&amp;langguage=en\" class=\"sj-btn secondary\">Design Your Own Soccer Jersey in 3D</a>\n<p class=\"sj-note\">No minimum order &middot; Youth to adult sizes &middot; Names &amp; numbers included &middot; Delivery in 25&ndash;30 days</p>\n</div>\n</div>",
