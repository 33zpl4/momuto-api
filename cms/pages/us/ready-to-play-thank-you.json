  "content": "<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Outfit:wght@300;400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\" /><link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n<style>\n  :root {\n    --rtp-bg: #0a0a0a;\n    --rtp-panel: #111;\n    --rtp-border: rgba(255,255,255,0.06);\n    --rtp-white: #f5f5f5;\n    --rtp-muted: #a1a1aa;\n    --rtp-dim: #71717a;\n    --rtp-red: #c8352e;\n    --rtp-red-hover: #e04038;\n    --whatsapp: #25D366;\n    --font-display: 'Bebas Neue', sans-serif;\n    --font-body: 'Outfit', sans-serif;\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: var(--font-body);\n    background: var(--rtp-bg);\n    color: var(--rtp-white);\n    line-height: 1.4;\n    overflow-x: hidden;\n  }\n  .title { display: none; }\n\n  /* ===== HERO ===== */\n  .rtp-ty-hero {\n    padding: 6rem 20px 3rem;\n    text-align: center;\n    background: var(--rtp-bg);\n    position: relative;\n  }\n  .rtp-ty-hero::after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 60px;\n    height: 1px;\n    background: var(--rtp-red);\n  }\n  .rtp-ty-badge {\n    display: inline-block;\n    padding: 6px 14px;\n    font-family: var(--font-body);\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--rtp-red);\n    background: rgba(200,53,46,0.1);\n    margin-bottom: 1.8rem;\n  }\n  .rtp-ty-hero h1 {\n    font-family: var(--font-display);\n    font-size: clamp(3rem, 8vw, 5.5rem);\n    font-weight: 400;\n    line-height: 0.9;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    margin-bottom: 1rem;\n  }\n  .rtp-ty-hero h3 {\n    font-family: var(--font-body);\n    font-size: 1rem;\n    font-weight: 300;\n    color: var(--rtp-muted);\n    max-width: 520px;\n    margin: 0 auto;\n    line-height: 1.6;\n  }\n\n  /* ===== MAIN CONTENT ===== */\n  .rtp-ty-container {\n    max-width: 900px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n  .rtp-ty-card {\n    background: var(--rtp-panel);\n    border: 1px solid var(--rtp-border);\n    padding: 52px 40px;\n    text-align: center;\n    margin-top: 40px;\n  }\n  .rtp-ty-lead {\n    font-size: 0.95rem;\n    font-weight: 300;\n    color: var(--rtp-muted);\n    max-width: 580px;\n    margin: 0 auto 44px;\n    line-height: 1.65;\n    padding-bottom: 36px;\n    border-bottom: 1px solid var(--rtp-border);\n  }\n  .rtp-ty-lead strong {\n    color: var(--rtp-white);\n    font-weight: 600;\n  }\n\n  /* ===== TIMELINE ===== */\n  .rtp-ty-timeline {\n    text-align: left;\n    margin-bottom: 44px;\n  }\n  .rtp-ty-timeline h3 {\n    font-family: var(--font-body);\n    font-size: 0.68rem;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--rtp-dim);\n    margin-bottom: 16px;\n  }\n  .rtp-ty-timeline-list {\n    list-style: none;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n  .rtp-ty-timeline-list li {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 16px 20px;\n    background: rgba(255,255,255,0.02);\n    border-left: 3px solid var(--rtp-red);\n    font-size: 0.88rem;\n    font-weight: 300;\n    color: var(--rtp-muted);\n    line-height: 1.45;\n  }\n  .rtp-ty-timeline-list li strong {\n    color: var(--rtp-white);\n    font-weight: 700;\n  }\n  .rtp-ty-step-num {\n    font-family: var(--font-display);\n    font-size: 1.2rem;\n    color: var(--rtp-red);\n    line-height: 1;\n    flex-shrink: 0;\n    min-width: 24px;\n  }\n\n  /* ===== SPEC GRID ===== */\n  .rtp-ty-specs {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1px;\n    background: var(--rtp-border);\n    margin-bottom: 44px;\n    border: 1px solid var(--rtp-border);\n  }\n  .rtp-ty-spec {\n    padding: 24px 18px;\n    text-align: left;\n    background: var(--rtp-panel);\n    transition: background 0.2s;\n  }\n  .rtp-ty-spec:hover { background: #1a1a1a; }\n  .rtp-ty-spec-label {\n    display: block;\n    font-size: 0.6rem;\n    font-weight: 700;\n    color: var(--rtp-dim);\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n  .rtp-ty-spec-title {\n    font-family: var(--font-display);\n    font-size: 1.1rem;\n    letter-spacing: 0.03em;\n    line-height: 1.1;\n    margin-bottom: 4px;\n  }\n  .rtp-ty-spec-desc {\n    font-size: 0.72rem;\n    font-weight: 300;\n    color: var(--rtp-dim);\n    line-height: 1.4;\n  }\n\n  /* ===== -10% CALLOUT ===== */\n  .rtp-ty-discount {\n    border: 1px solid rgba(200,53,46,0.15);\n    background: rgba(200,53,46,0.04);\n    padding: 20px 24px;\n    text-align: left;\n    margin-bottom: 24px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n  .rtp-ty-discount-icon {\n    font-family: var(--font-display);\n    font-size: 1.6rem;\n    color: var(--rtp-red);\n    flex-shrink: 0;\n    line-height: 1;\n  }\n  .rtp-ty-discount-text {\n    font-size: 0.82rem;\n    font-weight: 300;\n    color: var(--rtp-muted);\n    line-height: 1.5;\n  }\n  .rtp-ty-discount-text strong {\n    color: var(--rtp-white);\n    font-weight: 700;\n  }\n\n  /* ===== EMAIL NOTE ===== */\n  .rtp-ty-note {\n    border: 1px solid var(--rtp-border);\n    padding: 20px 24px;\n    text-align: left;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n  }\n  .rtp-ty-note i {\n    color: var(--rtp-red);\n    font-size: 0.95rem;\n    margin-top: 2px;\n    flex-shrink: 0;\n  }\n  .rtp-ty-note p {\n    font-size: 0.82rem;\n    font-weight: 300;\n    color: var(--rtp-muted);\n    line-height: 1.55;\n  }\n  .rtp-ty-note p strong {\n    color: var(--rtp-white);\n    font-weight: 700;\n  }\n\n  /* ===== WHATSAPP ===== */\n  .rtp-ty-whatsapp {\n    border: 1px solid var(--rtp-border);\n    padding: 20px 24px;\n    text-align: left;\n    margin-bottom: 44px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    justify-content: space-between;\n    flex-wrap: wrap;\n  }\n  .rtp-ty-wa-text {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    flex: 1;\n    min-width: 220px;\n  }\n  .rtp-ty-wa-text i {\n    color: var(--whatsapp);\n    font-size: 1rem;\n    margin-top: 2px;\n    flex-shrink: 0;\n  }\n  .rtp-ty-wa-text p {\n    font-size: 0.82rem;\n    font-weight: 300;\n    color: var(--rtp-dim);\n    line-height: 1.5;\n  }\n  .rtp-ty-wa-text p strong {\n    color: var(--rtp-muted);\n    font-weight: 600;\n  }\n  .rtp-ty-wa-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 14px 20px;\n    background: var(--whatsapp);\n    color: #fff;\n    text-decoration: none;\n    font-family: var(--font-body);\n    font-weight: 700;\n    font-size: 0.75rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    transition: all 0.2s ease;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n  .rtp-ty-wa-btn:hover {\n    background: #1ebe5d;\n    transform: translateY(-1px);\n  }\n\n  /* ===== BROWSE MORE ===== */\n  .rtp-ty-browse {\n    padding-top: 36px;\n    border-top: 1px solid var(--rtp-border);\n    text-align: center;\n    margin-bottom: 44px;\n  }\n  .rtp-ty-browse p {\n    font-size: 0.68rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--rtp-dim);\n    margin-bottom: 16px;\n  }\n  .rtp-ty-browse-links {\n    display: flex;\n    justify-content: center;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n  .rtp-ty-browse-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 12px 20px;\n    border: 1px solid var(--rtp-border);\n    color: var(--rtp-white);\n    text-decoration: none;\n    font-size: 0.78rem;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    transition: all 0.2s ease;\n  }\n  .rtp-ty-browse-link:hover {\n    border-color: var(--rtp-red);\n    background: rgba(200,53,46,0.04);\n  }\n  .rtp-ty-browse-link.rtp-ty-browse-primary {\n    border-color: rgba(200,53,46,0.2);\n    background: rgba(200,53,46,0.04);\n  }\n  .rtp-ty-browse-link.rtp-ty-browse-primary:hover {\n    border-color: var(--rtp-red);\n    background: rgba(200,53,46,0.08);\n  }\n  .rtp-ty-browse-link i {\n    font-size: 0.7rem;\n    color: var(--rtp-red);\n  }\n\n  /* ===== SOCIAL ===== */\n  .rtp-ty-social {\n    text-align: center;\n    padding-top: 36px;\n    border-top: 1px solid var(--rtp-border);\n  }\n  .rtp-ty-social p {\n    font-size: 0.68rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--rtp-dim);\n    margin-bottom: 14px;\n  }\n  .rtp-ty-ig {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--rtp-white);\n    text-decoration: none;\n    font-weight: 700;\n    font-size: 1rem;\n    letter-spacing: -0.01em;\n    transition: color 0.2s;\n  }\n  .rtp-ty-ig i { color: var(--rtp-red); }\n  .rtp-ty-ig:hover { color: var(--rtp-muted); }\n\n  /* ===== FOOTER ===== */\n  .rtp-ty-footer {\n    padding: 40px 20px 60px;\n    text-align: center;\n    border-top: 1px solid var(--rtp-border);\n    margin-top: 60px;\n  }\n  .rtp-ty-back {\n    color: var(--rtp-dim);\n    font-size: 0.75rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    text-decoration: none;\n    transition: color 0.2s;\n  }\n  .rtp-ty-back:hover { color: var(--rtp-white); }\n\n  /* ===== RESPONSIVE ===== */\n  @media (max-width: 768px) {\n    .rtp-ty-hero { padding: 4.5rem 20px 2.5rem; }\n    .rtp-ty-hero h1 { font-size: 3.5rem; }\n    .rtp-ty-card { padding: 40px 20px; }\n    .rtp-ty-specs { grid-template-columns: repeat(2, 1fr); }\n    .rtp-ty-timeline-list li { flex-direction: column; align-items: flex-start; gap: 4px; }\n    .rtp-ty-whatsapp { flex-direction: column; align-items: flex-start; }\n    .rtp-ty-wa-btn { width: 100%; justify-content: center; }\n  }\n  @media (max-width: 480px) {\n    .rtp-ty-specs { grid-template-columns: 1fr; }\n  }\n</style>\n<!-- ═══════════════════════════════════════\n     HERO\n     ═══════════════════════════════════════ --><header class=\"rtp-ty-hero\">\n<div class=\"rtp-ty-badge\">Ready-to-Play &middot; Request received</div>\n<h1>LET'S GO.</h1>\n<h3>Your colours and badge are in our hands. Your preview arrives within 24h.</h3>\n</header><!-- ═══════════════════════════════════════\n     MAIN CONTENT\n     ═══════════════════════════════════════ -->\n<div class=\"rtp-ty-container\">\n<div class=\"rtp-ty-card\">\n<p class=\"rtp-ty-lead\">A senior designer is adapting <strong>your Ready-to-Play design</strong> with your colours and positioning your logos. Keep an eye on your inbox &mdash; it's coming fast.</p>\n<!-- TIMELINE -->\n<div class=\"rtp-ty-timeline\">\n<h3>What happens next</h3>\n<ul class=\"rtp-ty-timeline-list\">\n<li><span class=\"rtp-ty-step-num\">01</span> <span>Your personalised preview arrives <strong>within 24h</strong> in your inbox</span></li>\n<li><span class=\"rtp-ty-step-num\">02</span> <span>You approve the result &mdash; <strong>1 revision included</strong> if needed</span></li>\n<li><span class=\"rtp-ty-step-num\">03</span> <span>You receive your <strong>order link with -10%</strong> Ready-to-Play discount</span></li>\n<li><span class=\"rtp-ty-step-num\">04</span> <span>Production starts &mdash; <strong>delivery in 20&ndash;25 days</strong></span></li>\n</ul>\n</div>\n<!-- SPEC GRID -->\n<div class=\"rtp-ty-specs\">\n<div class=\"rtp-ty-spec\"><span class=\"rtp-ty-spec-label\">FAST</span>\n<div class=\"rtp-ty-spec-title\">PREVIEW 24H</div>\n<div class=\"rtp-ty-spec-desc\">Not days. Not weeks. Tomorrow.</div>\n</div>\n<div class=\"rtp-ty-spec\"><span class=\"rtp-ty-spec-label\">PERSONALISED</span>\n<div class=\"rtp-ty-spec-title\">YOUR COLOURS</div>\n<div class=\"rtp-ty-spec-desc\">Badge, sponsors and colours professionally integrated.</div>\n</div>\n<div class=\"rtp-ty-spec\"><span class=\"rtp-ty-spec-label\">BETTER VALUE</span>\n<div class=\"rtp-ty-spec-title\">-10% GUARANTEED</div>\n<div class=\"rtp-ty-spec-desc\">Ready-to-Play pricing applied to your order.</div>\n</div>\n<div class=\"rtp-ty-spec\"><span class=\"rtp-ty-spec-label\">RISK-FREE</span>\n<div class=\"rtp-ty-spec-title\">ZERO COMMITMENT</div>\n<div class=\"rtp-ty-spec-desc\">You see it first. You decide after.</div>\n</div>\n</div>\n<!-- -10% CALLOUT -->\n<div class=\"rtp-ty-discount\">\n<div class=\"rtp-ty-discount-icon\">-10%</div>\n<div class=\"rtp-ty-discount-text\"><strong>Your Ready-to-Play price is locked in.</strong> By choosing a proven design, you save 10% vs. custom. The order link with your price will appear in the email with your preview.</div>\n</div>\n<!-- EMAIL NOTE -->\n<div class=\"rtp-ty-note\"><i class=\"fas fa-envelope\"></i>\n<p><strong>We'll email you.</strong> If you don't hear from us within 24h, check your spam or promotions &mdash; we're on it.</p>\n</div>\n<!-- WHATSAPP -->\n<div class=\"rtp-ty-whatsapp\">\n<div class=\"rtp-ty-wa-text\"><i class=\"fab fa-whatsapp\"></i>\n<p><strong>Need a quick reply?</strong> Send us a message with your team name.</p>\n</div>\n<a href=\"https://wa.me/34614625408?text=Hi%20MOMUTO%2C%20I%20just%20submitted%20a%20Ready-to-Play%20request%20for%20my%20team%3A%20\" class=\"rtp-ty-wa-btn\" target=\"_blank\" rel=\"noopener\"> <i class=\"fab fa-whatsapp\"></i> Open WhatsApp </a></div>\n<!-- BROWSE MORE -->\n<div class=\"rtp-ty-browse\">\n<p>While you wait</p>\n<div class=\"rtp-ty-browse-links\"><a href=\"/pages/portfolio\" class=\"rtp-ty-browse-link rtp-ty-browse-primary\"> <i class=\"fas fa-arrow-right\"></i> See teams in MOMUTO </a> <a href=\"/collections/ready-to-play\" class=\"rtp-ty-browse-link\"> <i class=\"fas fa-arrow-right\"></i> Explore more designs </a></div>\n</div>\n<!-- SOCIAL -->\n<div class=\"rtp-ty-social\">\n<p>Get inspired</p>\n<a href=\"https://www.instagram.com/momutofc\" target=\"_blank\" rel=\"noopener\" class=\"rtp-ty-ig\"> <i class=\"fab fa-instagram\"></i> @momutofc </a></div>\n</div>\n</div>\n<!-- FOOTER -->\n<div class=\"rtp-ty-footer\"><a href=\"/\" class=\"rtp-ty-back\">Back to homepage</a></div>",
