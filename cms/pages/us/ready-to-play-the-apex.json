  "content": "<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n\n<style>\n/* ===== GLOBAL RESETS ===== */\nhtml, body {\n  background-color: #0a0a0a !important;\n  color: #f5f5f5;\n}\nh1.title, .title, .page-title, .section-header h1, h1.section-header__title {\n  display: none !important;\n}\n.container_wrapper, .page-width, .container, .main-content {\n  max-width: 100% !important; width: 100% !important;\n  padding: 0 !important; margin: 0 !important;\n  overflow: visible !important;\n}\n*, *::before, *::after { box-sizing: border-box; }\n\n/* ===== VARIABLES ===== */\n:root {\n  --rtp-bg: #0a0a0a;\n  --rtp-panel: #111;\n  --rtp-border: rgba(255,255,255,0.06);\n  --rtp-border-hover: rgba(255,255,255,0.15);\n  --rtp-white: #f5f5f5;\n  --rtp-muted: #a1a1aa;\n  --rtp-dim: #71717a;\n  --rtp-red: #c8352e;\n  --rtp-red-hover: #e04038;\n  --font-display: 'Bebas Neue', sans-serif;\n  --font-body: 'Outfit', sans-serif;\n}\n\n/* ===== PAGE WRAPPER ===== */\n.rtp-page {\n  font-family: var(--font-body);\n  background: var(--rtp-bg);\n  color: var(--rtp-white);\n  width: 100%;\n  min-height: 100vh;\n  overflow-x: clip;\n  padding-bottom: 80px;\n}\n\n.rtp-container {\n  max-width: 1280px;\n  margin: 0 auto;\n  padding: 40px;\n  display: grid;\n  grid-template-columns: 1.3fr 0.7fr;\n  gap: 60px;\n}\n\n/* ===== CONTEXT BANNER ===== */\n.rtp-banner-wrap { grid-column: 1 / -1; margin-bottom: 10px; }\n.rtp-banner {\n  border-left: 3px solid var(--rtp-red);\n  padding: 20px 24px;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  background: linear-gradient(90deg, var(--rtp-panel) 0%, rgba(17,17,17,0) 100%);\n}\n.rtp-banner-badge {\n  font-family: var(--font-body);\n  font-size: 0.65rem;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--rtp-red);\n  background: rgba(200,53,46,0.1);\n  padding: 5px 12px;\n  white-space: nowrap;\n}\n.rtp-banner-text {\n  font-size: 0.82rem;\n  font-weight: 300;\n  color: var(--rtp-muted);\n  line-height: 1.5;\n}\n.rtp-banner-text strong { color: var(--rtp-white); font-weight: 600; }\n\n/* ===== LEFT COLUMN: VISUALS ===== */\n.rtp-visual {\n  position: sticky;\n  top: 40px;\n  display: grid;\n  grid-template-columns: 90px 1fr;\n  gap: 16px;\n  align-self: start;\n  height: fit-content;\n}\n\n.rtp-thumbs {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.rtp-thumb {\n  aspect-ratio: 1;\n  width: 100%;\n  background: var(--rtp-panel);\n  border: 1px solid var(--rtp-border);\n  cursor: pointer;\n  padding: 4px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0.5;\n  transition: all 0.2s ease;\n}\n.rtp-thumb:hover,\n.rtp-thumb.active {\n  border-color: var(--rtp-white);\n  opacity: 1;\n}\n.rtp-thumb img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.rtp-main-img-wrap {\n  width: 100%;\n  aspect-ratio: 1;\n  background: var(--rtp-panel);\n  border: 1px solid var(--rtp-border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n  cursor: zoom-in;\n}\n.rtp-main-img {\n  width: 92%;\n  height: 92%;\n  object-fit: contain;\n  filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));\n  transition: opacity 0.2s ease;\n}\n\n/* ===== RIGHT COLUMN: FORM ===== */\n.rtp-form-col { padding-top: 0; }\n\n/* Header */\n.rtp-header {\n  margin-bottom: 28px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--rtp-border);\n}\n.rtp-collection-label {\n  font-family: var(--font-body);\n  font-size: 0.65rem;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--rtp-red);\n  margin-bottom: 6px;\n  display: block;\n}\n.rtp-design-title {\n  font-family: var(--font-display);\n  font-size: clamp(2.5rem, 5vw, 3.5rem);\n  font-weight: 400;\n  text-transform: uppercase;\n  margin: 0;\n  line-height: 0.95;\n  color: var(--rtp-white);\n  letter-spacing: 0.03em;\n}\n.rtp-design-desc {\n  font-size: 0.88rem;\n  font-weight: 300;\n  color: var(--rtp-muted);\n  margin-top: 14px;\n  line-height: 1.7;\n}\n\n/* ── VALUE STRIP ── */\n.rtp-value-strip {\n  background: rgba(255,255,255,0.02);\n  border: 1px solid var(--rtp-border);\n  padding: 20px 22px;\n  margin-bottom: 28px;\n}\n.rtp-value-headline {\n  font-size: 0.88rem;\n  font-weight: 600;\n  color: var(--rtp-white);\n  margin: 0 0 14px 0;\n  line-height: 1.4;\n}\n.rtp-value-headline span { color: var(--rtp-red); }\n.rtp-value-features { display: flex; gap: 0; }\n.rtp-value-feature {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 0.7rem;\n  font-weight: 400;\n  color: var(--rtp-muted);\n  padding: 0 14px;\n  border-left: 1px solid var(--rtp-border);\n}\n.rtp-value-feature:first-child { padding-left: 0; border-left: none; }\n.rtp-value-icon {\n  width: 28px; height: 28px;\n  border: 1px solid rgba(255,255,255,0.1);\n  border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n}\n.rtp-value-icon svg {\n  width: 12px; height: 12px;\n  stroke: var(--rtp-red); fill: none;\n  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;\n}\n\n/* ── FORM SECTIONS ── */\n.rtp-section-title {\n  font-family: var(--font-body);\n  font-size: 0.72rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.14em;\n  color: var(--rtp-white);\n  margin: 32px 0 16px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid var(--rtp-border);\n}\n.rtp-section-num {\n  font-family: var(--font-display);\n  font-size: 1.1rem;\n  color: var(--rtp-red);\n  line-height: 1;\n}\n\n/* ── COLOR PICKER (INLINE SWATCHES) ── */\n.rtp-color-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 0;\n  border-bottom: 1px solid var(--rtp-border);\n  cursor: pointer;\n  transition: opacity 0.2s;\n}\n.rtp-color-row:hover { opacity: 0.8; }\n.rtp-color-row-last { border-bottom: none; }\n.rtp-color-info { display: flex; flex-direction: column; gap: 2px; }\n.rtp-color-name {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: var(--rtp-white);\n}\n.rtp-color-hint {\n  font-size: 0.68rem;\n  font-weight: 300;\n  color: var(--rtp-dim);\n}\n.rtp-color-selected {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  cursor: pointer;\n}\n.rtp-color-preview {\n  width: 28px; height: 28px;\n  border: 2px solid rgba(255,255,255,0.12);\n  transition: border-color 0.2s;\n}\n.rtp-color-row:hover .rtp-color-preview { border-color: rgba(255,255,255,0.3); }\n.rtp-color-selected-label {\n  font-size: 0.7rem;\n  font-weight: 400;\n  color: var(--rtp-dim);\n  min-width: 50px;\n}\n.rtp-color-chevron { transition: transform 0.25s ease; }\n.rtp-color-row.rtp-row-open .rtp-color-chevron { transform: rotate(180deg); }\n\n/* Swatch panel */\n.rtp-swatch-panel {\n  max-height: 0;\n  overflow: hidden;\n  opacity: 0;\n  transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.3s ease;\n  padding: 0;\n}\n.rtp-swatch-panel.rtp-panel-open {\n  max-height: 200px;\n  opacity: 1;\n  padding: 12px 0 16px;\n}\n.rtp-swatch-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, 30px);\n  gap: 7px;\n  justify-content: start;\n}\n.rtp-swatch {\n  width: 30px; height: 30px;\n  border: 2px solid rgba(255,255,255,0.06);\n  cursor: pointer;\n  transition: transform 0.15s ease, border-color 0.15s ease;\n  position: relative;\n}\n.rtp-swatch:hover {\n  transform: scale(1.15);\n  border-color: rgba(255,255,255,0.3);\n  z-index: 2;\n}\n.rtp-swatch.rtp-swatch-active {\n  border-color: var(--rtp-red);\n  transform: scale(1.1);\n}\n.rtp-swatch[data-color=\"#FFFFFF\"],\n.rtp-swatch[data-color=\"#F5F1E8\"],\n.rtp-swatch[data-color=\"#D9D9D9\"] {\n  border-color: rgba(255,255,255,0.15);\n}\n.rtp-swatch.rtp-swatch-active::after {\n  content: '';\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 8px; height: 8px;\n  border-radius: 50%;\n  background: var(--rtp-red);\n  box-shadow: 0 0 0 2px var(--rtp-bg);\n}\n.rtp-swatch.rtp-swatch-active.rtp-swatch-light::after {\n  background: #0a0a0a;\n  box-shadow: 0 0 0 2px #fff;\n}\n.rtp-custom-color-note {\n  font-size: 0.65rem;\n  font-weight: 300;\n  color: var(--rtp-dim);\n  margin-top: 14px;\n  padding-top: 10px;\n  border-top: 1px solid rgba(255,255,255,0.04);\n}\n\n/* ── FORM INPUTS ── */\n.rtp-input-group { margin-bottom: 18px; }\n.rtp-input-group label {\n  display: block;\n  font-size: 0.68rem;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: var(--rtp-dim);\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n.rtp-input, .rtp-select {\n  width: 100%;\n  background: var(--rtp-panel);\n  border: 1px solid var(--rtp-border);\n  color: var(--rtp-white);\n  font-family: var(--font-body);\n  font-size: 0.88rem;\n  font-weight: 400;\n  height: 48px;\n  padding: 0 14px;\n}\n.rtp-input:focus, .rtp-select:focus {\n  outline: none;\n  border-color: var(--rtp-white);\n}\n.rtp-input::placeholder { color: var(--rtp-dim); font-weight: 300; }\n\n/* File upload */\n.rtp-file-btn {\n  width: 100%;\n  background: var(--rtp-panel);\n  border: 1px dashed rgba(255,255,255,0.1);\n  color: var(--rtp-muted);\n  font-family: var(--font-body);\n  font-weight: 600;\n  font-size: 0.75rem;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  cursor: pointer;\n  height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  transition: border-color 0.2s;\n}\n.rtp-file-btn:hover { border-color: rgba(255,255,255,0.25); }\n.rtp-file-status {\n  font-size: 0.72rem;\n  margin-top: 5px;\n  color: var(--rtp-red);\n  font-weight: 500;\n}\n\n/* ── PRICE BLOCK ── */\n.rtp-price-block {\n  margin-bottom: 24px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--rtp-border);\n}\n.rtp-price-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.rtp-price-main {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n}\n.rtp-price-current {\n  font-family: var(--font-display);\n  font-size: 2rem;\n  color: var(--rtp-white);\n  line-height: 1;\n}\n.rtp-price-original {\n  font-family: var(--font-body);\n  font-size: 0.9rem;\n  color: var(--rtp-dim);\n  text-decoration: line-through;\n  font-weight: 400;\n}\n.rtp-price-per {\n  font-family: var(--font-body);\n  font-size: 0.78rem;\n  color: var(--rtp-muted);\n  font-weight: 400;\n}\n.rtp-price-badge {\n  font-family: var(--font-body);\n  font-size: 0.6rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  color: var(--rtp-red);\n  background: rgba(200,53,46,0.1);\n  padding: 4px 10px;\n}\n.rtp-price-detail {\n  font-size: 0.68rem;\n  font-weight: 300;\n  color: var(--rtp-dim);\n  margin-top: 6px;\n}\n\n/* ── KIT TYPE SELECTOR ── */\n.rtp-kit-selector {\n  display: flex;\n  gap: 10px;\n}\n.rtp-kit-option {\n  flex: 1;\n  padding: 14px 16px;\n  border: 1px solid var(--rtp-border);\n  background: transparent;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  text-align: center;\n}\n.rtp-kit-option:hover {\n  border-color: var(--rtp-border-hover);\n}\n.rtp-kit-option.rtp-kit-active {\n  border-color: var(--rtp-red);\n  background: rgba(200,53,46,0.04);\n}\n.rtp-kit-option-title {\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: var(--rtp-white);\n  margin-bottom: 4px;\n}\n.rtp-kit-option-price {\n  font-size: 0.72rem;\n  color: var(--rtp-muted);\n  font-weight: 400;\n}\n.rtp-kit-option-price s {\n  color: var(--rtp-dim);\n  margin-right: 4px;\n}\n.rtp-kit-label-short {\n  font-size: 0.62rem;\n  color: var(--rtp-dim);\n  display: block;\n  margin-top: 2px;\n}\n\n/* ── KIT PERKS ── */\n.rtp-kit-perks {\n  background: rgba(200,53,46,0.04);\n  border: 1px solid rgba(200,53,46,0.12);\n  padding: 14px 18px;\n  margin-bottom: 18px;\n}\n.rtp-kit-perk {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 0.75rem;\n  color: var(--rtp-muted);\n  padding: 4px 0;\n}\n.rtp-kit-perk i {\n  color: var(--rtp-red);\n  font-size: 0.7rem;\n  width: 16px;\n  text-align: center;\n  flex-shrink: 0;\n}\n.rtp-kit-perk strong {\n  color: var(--rtp-white);\n  font-weight: 600;\n}\n\n/* ── TRUST BOX ── */\n.rtp-trust {\n  background: var(--rtp-panel);\n  border: 1px solid var(--rtp-border);\n  border-left: 3px solid var(--rtp-red);\n  padding: 22px 24px;\n  margin: 28px 0;\n  display: flex;\n  gap: 16px;\n  align-items: flex-start;\n}\n.rtp-trust-icon {\n  color: var(--rtp-red);\n  font-size: 1rem;\n  margin-top: 2px;\n  flex-shrink: 0;\n}\n.rtp-trust-title {\n  font-size: 0.78rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--rtp-white);\n  margin: 0 0 4px 0;\n}\n.rtp-trust-text {\n  font-size: 0.78rem;\n  font-weight: 300;\n  color: var(--rtp-muted);\n  margin: 0;\n  line-height: 1.6;\n}\n.rtp-trust-text strong { color: var(--rtp-white); font-weight: 600; }\n\n/* ── SUBMIT BUTTON ── */\n.rtp-submit {\n  width: 100%;\n  background: var(--rtp-red);\n  color: #fff;\n  border: none;\n  padding: 20px;\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  margin-top: 8px;\n}\n.rtp-submit:hover {\n  background: var(--rtp-red-hover);\n  transform: translateY(-2px);\n}\n\n/* ── CTA SUBTEXT ── */\n.rtp-submit-note {\n  text-align: center;\n  font-size: 0.65rem;\n  color: var(--rtp-dim);\n  margin-top: 10px;\n  font-weight: 400;\n}\n\n/* ── REASSURANCE LINK ── */\n.rtp-alt-path {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  margin-top: 24px;\n  padding-top: 20px;\n  border-top: 1px solid var(--rtp-border);\n  font-size: 0.72rem;\n  font-weight: 500;\n  color: var(--rtp-dim);\n}\n.rtp-alt-path a {\n  color: var(--rtp-red);\n  text-decoration: none;\n  font-weight: 600;\n  transition: opacity 0.2s;\n}\n.rtp-alt-path a:hover { opacity: 0.7; }\n\n/* ===== LIGHTBOX ===== */\n.rtp-lightbox {\n  position: fixed;\n  top: 0; left: 0;\n  width: 100%; height: 100%;\n  background: rgba(0,0,0,0.95);\n  z-index: 99999;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  backdrop-filter: blur(5px);\n}\n.rtp-lightbox.active { display: flex; }\n.rtp-lightbox-img {\n  max-width: 85vw;\n  max-height: 85vh;\n  object-fit: contain;\n  filter: drop-shadow(0 0 40px rgba(0,0,0,0.5));\n}\n.rtp-lb-close {\n  position: absolute;\n  top: 20px; right: 20px;\n  color: #fff;\n  font-size: 1.8rem;\n  cursor: pointer;\n  background: none;\n  border: none;\n}\n.rtp-lb-nav {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  background: none;\n  border: none;\n  color: rgba(255,255,255,0.3);\n  font-size: 2.5rem;\n  cursor: pointer;\n  padding: 20px;\n  transition: color 0.2s;\n}\n.rtp-lb-nav:hover { color: var(--rtp-red); }\n.rtp-lb-prev { left: 20px; }\n.rtp-lb-next { right: 20px; }\n\n/* ===== RESPONSIVE ===== */\n@media (max-width: 1024px) {\n  .rtp-container {\n    grid-template-columns: 1fr;\n    gap: 40px;\n    padding: 24px 20px;\n  }\n  .rtp-visual {\n    position: static;\n    grid-template-columns: 1fr;\n  }\n  .rtp-thumbs {\n    flex-direction: row;\n    order: 2;\n    overflow-x: auto;\n    padding-bottom: 8px;\n    gap: 8px;\n  }\n  .rtp-thumb { width: 72px; flex-shrink: 0; }\n  .rtp-main-img-wrap { order: 1; }\n  .rtp-value-features { flex-direction: column; gap: 10px; }\n  .rtp-value-feature { padding: 0; border-left: none; }\n}\n</style>\n\n<!-- ═══════════════════════════════════════\n     PAGE STRUCTURE\n     ═══════════════════════════════════════ -->\n<div class=\"rtp-page\">\n<div class=\"rtp-container\">\n\n  <!-- BANNER -->\n  <div class=\"rtp-banner-wrap\">\n    <div class=\"rtp-banner\">\n      <div class=\"rtp-banner-badge\">Ready-to-Play</div>\n      <div class=\"rtp-banner-text\">Designs created by our designers, worn by real clubs. No design phase. <strong>Save time and save 10%.</strong></div>\n    </div>\n  </div>\n\n  <!-- LEFT: VISUALS -->\n  <div class=\"rtp-visual\">\n    <div class=\"rtp-thumbs\">\n      <div class=\"rtp-thumb active\" onclick=\"rtpSelectVariant(0)\">\n        <img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/3d9fea03f4408ada1395806d63127b14.webp\" alt=\"Apex White\">\n      </div>\n      <div class=\"rtp-thumb\" onclick=\"rtpSelectVariant(1)\">\n        <img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/1f1021f3b7949a43631730854183acb0.webp\" alt=\"Apex Joga Bonito\">\n      </div>\n      <div class=\"rtp-thumb\" onclick=\"rtpSelectVariant(2)\">\n        <img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/92b8c420d06911b03e847d1c2c78fe05.webp\" alt=\"Apex Tech-Ops\">\n      </div>\n    </div>\n    <div class=\"rtp-main-img-wrap\" onclick=\"rtpOpenLightbox()\">\n      <img src=\"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/3d9fea03f4408ada1395806d63127b14.webp\" class=\"rtp-main-img\" id=\"rtpMainDisplay\" alt=\"The Apex\">\n    </div>\n  </div>\n\n  <!-- RIGHT: FORM -->\n  <div class=\"rtp-form-col\">\n\n    <!-- Header -->\n    <div class=\"rtp-header\">\n      <span class=\"rtp-collection-label\">Ready-to-Play Collection</span>\n      <h1 class=\"rtp-design-title\">THE APEX</h1>\n      <p class=\"rtp-design-desc\">Engineered for speed. Aerodynamic curved side panels inspired by 2000s performance wear. Clean chest optimized for sponsor visibility.</p>\n    </div>\n\n    <!-- Price Display -->\n    <div class=\"rtp-price-block\">\n      <div class=\"rtp-price-row\" id=\"rtpPriceJersey\">\n        <div class=\"rtp-price-main\">\n          <span class=\"rtp-price-current\">$23.30</span>\n          <span class=\"rtp-price-original\">$25.90</span>\n          <span class=\"rtp-price-per\">/ jersey</span>\n        </div>\n        <div class=\"rtp-price-badge\">READY-TO-PLAY · -10%</div>\n      </div>\n      <div class=\"rtp-price-row rtp-price-row-kit\" id=\"rtpPriceKit\" style=\"display:none;\">\n        <div class=\"rtp-price-main\">\n          <span class=\"rtp-price-current\">$27.80</span>\n          <span class=\"rtp-price-original\">$30.90</span>\n          <span class=\"rtp-price-per\">/ full kit</span>\n        </div>\n        <div class=\"rtp-price-badge\">READY-TO-PLAY · -10%</div>\n      </div>\n      <div class=\"rtp-price-detail\">jersey + shorts · from 10 pieces</div>\n    </div>\n\n    <!-- Value Strip -->\n    <div class=\"rtp-value-strip\">\n      <div class=\"rtp-value-headline\">Same premium quality. Skip the wait. <span>-10%.</span></div>\n      <div class=\"rtp-value-features\">\n        <div class=\"rtp-value-feature\">\n          <div class=\"rtp-value-icon\"><svg viewBox=\"0 0 24 24\"><circle cx=\"13.5\" cy=\"6.5\" r=\"2.5\"/><circle cx=\"6\" cy=\"13.5\" r=\"2.5\"/><circle cx=\"18\" cy=\"18\" r=\"2.5\"/><path d=\"M11.5 8.5 8 12m7-1.5-3.5 5\"/></svg></div>\n          Your colors & badge\n        </div>\n        <div class=\"rtp-value-feature\">\n          <div class=\"rtp-value-icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"0\"/><path d=\"M3 9h18M9 3v18\"/></svg></div>\n          Preview in 24h\n        </div>\n        <div class=\"rtp-value-feature\">\n          <div class=\"rtp-value-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg></div>\n          1 revision included\n        </div>\n      </div>\n    </div>\n\n    <!-- FORM -->\n    <form id=\"rtpForm\" enctype=\"multipart/form-data\" method=\"POST\" action=\"https://momuto-api.vercel.app/api/submit\">\n\n      <!-- Hidden fields for colors -->\n      <input type=\"hidden\" id=\"rtpPrimaryValue\" name=\"Primary Colour\" value=\"#001F5B\">\n      <input type=\"hidden\" id=\"rtpSecondaryValue\" name=\"Secondary Colour\" value=\"#C4A46B\">\n      <input type=\"hidden\" id=\"rtpTrimValue\" name=\"Trim Colour\" value=\"#FFFFFF\">\n      <input type=\"hidden\" name=\"Design\" value=\"The Apex\">\n      <input type=\"hidden\" name=\"_next\" value=\"/pages/ready-to-play-thank-you\">\n      <input type=\"hidden\" name=\"_source_url\" id=\"_sourceUrl\" value=\"\">\n      <input type=\"hidden\" id=\"rtpKitTypeValue\" name=\"Kit Type\" value=\"Jersey only\">\n\n      <!-- SECTION 1: COLORS -->\n      <h3 class=\"rtp-section-title\">\n        <span class=\"rtp-section-num\">01</span>\n        Configure your colors\n      </h3>\n\n      <div class=\"rtp-color-row\" data-rtp-property=\"primary\" data-hidden=\"rtpPrimaryValue\">\n        <div class=\"rtp-color-info\">\n          <span class=\"rtp-color-name\">Primary</span>\n          <span class=\"rtp-color-hint\">jersey body</span>\n        </div>\n        <div class=\"rtp-color-selected\" data-default=\"#001F5B\" data-default-name=\"navy\">\n          <div class=\"rtp-color-preview\" style=\"background:#001F5B;\"></div>\n          <span class=\"rtp-color-selected-label\">navy</span>\n          <svg class=\"rtp-color-chevron\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"#71717a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg>\n        </div>\n      </div>\n      <div class=\"rtp-swatch-panel\" data-for=\"primary\"></div>\n\n      <div class=\"rtp-color-row\" data-rtp-property=\"secondary\" data-hidden=\"rtpSecondaryValue\">\n        <div class=\"rtp-color-info\">\n          <span class=\"rtp-color-name\">Secondary</span>\n          <span class=\"rtp-color-hint\">panels & accents</span>\n        </div>\n        <div class=\"rtp-color-selected\" data-default=\"#C4A46B\" data-default-name=\"gold\">\n          <div class=\"rtp-color-preview\" style=\"background:#C4A46B;\"></div>\n          <span class=\"rtp-color-selected-label\">gold</span>\n          <svg class=\"rtp-color-chevron\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"#71717a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg>\n        </div>\n      </div>\n      <div class=\"rtp-swatch-panel\" data-for=\"secondary\"></div>\n\n      <div class=\"rtp-color-row rtp-color-row-last\" data-rtp-property=\"trim\" data-hidden=\"rtpTrimValue\">\n        <div class=\"rtp-color-info\">\n          <span class=\"rtp-color-name\">Trim</span>\n          <span class=\"rtp-color-hint\">collar & cuffs</span>\n        </div>\n        <div class=\"rtp-color-selected\" data-default=\"#FFFFFF\" data-default-name=\"white\">\n          <div class=\"rtp-color-preview\" style=\"background:#FFFFFF;\"></div>\n          <span class=\"rtp-color-selected-label\">white</span>\n          <svg class=\"rtp-color-chevron\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"#71717a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg>\n        </div>\n      </div>\n      <div class=\"rtp-swatch-panel\" data-for=\"trim\"></div>\n\n      <div class=\"rtp-custom-color-note\">\n        Can't find your exact color? Specify it in the comments below.\n      </div>\n\n      <!-- SECTION 2: IDENTITY -->\n      <h3 class=\"rtp-section-title\">\n        <span class=\"rtp-section-num\">02</span>\n        Your team\n      </h3>\n\n      <!-- Kit type selector -->\n      <div class=\"rtp-input-group\">\n        <label>Kit type</label>\n        <div class=\"rtp-kit-selector\">\n          <div class=\"rtp-kit-option rtp-kit-active\" onclick=\"rtpSelectKit('jersey', this)\">\n            <div class=\"rtp-kit-option-title\">Jersey only</div>\n            <div class=\"rtp-kit-option-price\"><s>$25.90</s> $23.30</div>\n          </div>\n          <div class=\"rtp-kit-option\" onclick=\"rtpSelectKit('fullkit', this)\">\n            <div class=\"rtp-kit-option-title\">Full kit</div>\n            <div class=\"rtp-kit-option-price\"><s>$30.90</s> $27.80 <span class=\"rtp-kit-label-short\">jersey + shorts</span></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Full kit perks (hidden by default) -->\n      <div class=\"rtp-kit-perks\" id=\"rtpKitPerks\" style=\"display:none;\">\n        <div class=\"rtp-kit-perk\">\n          <i class=\"fas fa-flag\"></i>\n          <span><strong>Free team flag</strong> with crest · for orders of 10+ pieces</span>\n        </div>\n        <div class=\"rtp-kit-perk\">\n          <i class=\"fas fa-star\"></i>\n          <span><strong>Free captain armband</strong> · for orders of 10+ pieces</span>\n        </div>\n      </div>\n\n      <!-- Team name -->\n      <div class=\"rtp-input-group\">\n        <label>Team name</label>\n        <input type=\"text\" name=\"teamName\" class=\"rtp-input\" placeholder=\"e.g. FC Wolf Pack\" required>\n      </div>\n\n      <!-- File uploads -->\n      <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:16px;\">\n        <div class=\"rtp-input-group\">\n          <label>Team crest</label>\n          <label for=\"rtpCrest\" class=\"rtp-file-btn\">\n            <i class=\"fas fa-upload\"></i> Upload\n          </label>\n          <input type=\"file\" id=\"rtpCrest\" name=\"teamCrest\" style=\"display:none;\" onchange=\"rtpShowFile(this,'rtpCrestStatus')\">\n          <div id=\"rtpCrestStatus\" class=\"rtp-file-status\"></div>\n        </div>\n        <div class=\"rtp-input-group\">\n          <label>Sponsor logo (optional)</label>\n          <label for=\"rtpSponsor\" class=\"rtp-file-btn\">\n            <i class=\"fas fa-upload\"></i> Upload\n          </label>\n          <input type=\"file\" id=\"rtpSponsor\" name=\"sponsorLogo\" style=\"display:none;\" onchange=\"rtpShowFile(this,'rtpSponsorStatus')\">\n          <div id=\"rtpSponsorStatus\" class=\"rtp-file-status\"></div>\n        </div>\n      </div>\n\n      <!-- SECTION 3: CONTACT -->\n      <h3 class=\"rtp-section-title\">\n        <span class=\"rtp-section-num\">03</span>\n        Contact & details\n      </h3>\n\n      <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:16px;\">\n        <div class=\"rtp-input-group\">\n          <label>Name</label>\n          <input type=\"text\" name=\"contactName\" class=\"rtp-input\" placeholder=\"Your name\" required>\n        </div>\n        <div class=\"rtp-input-group\">\n          <label>Email</label>\n          <input type=\"email\" name=\"contactEmail\" class=\"rtp-input\" placeholder=\"your@email.com\" required>\n        </div>\n      </div>\n\n      <div class=\"rtp-input-group\">\n        <label>Estimated quantity</label>\n        <select name=\"estimatedQty\" class=\"rtp-select\" required>\n          <option value=\"\" disabled selected>Select...</option>\n          <option value=\"1-10\">1–10 jerseys</option>\n          <option value=\"11-20\">11–20 jerseys</option>\n          <option value=\"21-50\">21–50 jerseys</option>\n          <option value=\"50+\">50+ (club)</option>\n        </select>\n      </div>\n\n      <div class=\"rtp-input-group\">\n        <label>Comments (optional)</label>\n        <input type=\"text\" name=\"comments\" class=\"rtp-input\" placeholder=\"Exact colour, additional details...\">\n      </div>\n\n      <!-- TRUST BOX -->\n      <div class=\"rtp-trust\">\n        <div class=\"rtp-trust-icon\"><i class=\"fas fa-check-circle\"></i></div>\n        <div>\n          <h4 class=\"rtp-trust-title\">Pro preview in 24h</h4>\n          <p class=\"rtp-trust-text\">A <strong>senior designer</strong> will adapt this design with your colors and position your logos. You'll receive a high-quality preview before any commitment.</p>\n        </div>\n      </div>\n\n      <!-- SUBMIT -->\n      <button type=\"submit\" class=\"rtp-submit\">GET MY PREVIEW · 24H</button>\n      <div class=\"rtp-submit-note\">Free · No commitment · 1 revision included</div>\n\n    </form>\n\n    <!-- ALT PATH -->\n    <div class=\"rtp-alt-path\">\n      Prefer a 100% unique design?\n      <a href=\"/pages/request-design\">Request a free custom design →</a>\n    </div>\n\n  </div>\n</div>\n</div>\n\n<!-- LIGHTBOX -->\n<div id=\"rtpLightbox\" class=\"rtp-lightbox\">\n  <button class=\"rtp-lb-close\" onclick=\"rtpCloseLightbox()\">×</button>\n  <button class=\"rtp-lb-nav rtp-lb-prev\" onclick=\"rtpNavLightbox(-1)\"><i class=\"fas fa-chevron-left\"></i></button>\n  <button class=\"rtp-lb-nav rtp-lb-next\" onclick=\"rtpNavLightbox(1)\"><i class=\"fas fa-chevron-right\"></i></button>\n  <img id=\"rtpLightboxImg\" class=\"rtp-lightbox-img\">\n</div>\n\n<!-- ═══════════════════════════════════════\n     SCRIPTS\n     ═══════════════════════════════════════ -->\n<script>\n(function() {\n  /* ── IMAGES ── */\n  var rtpImages = [\n    \"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/3d9fea03f4408ada1395806d63127b14.webp\",\n    \"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/1f1021f3b7949a43631730854183acb0.webp\",\n    \"https://cdn.staticsoe.com/uploads/47711/cart/resources/20251204/92b8c420d06911b03e847d1c2c78fe05.webp\"\n  ];\n  var rtpCurrentIdx = 0;\n\n  /* Fix CMS overflow */\n  document.addEventListener('DOMContentLoaded', function() {\n    var su = document.getElementById('_sourceUrl'); if (su) su.value = window.location.href;\n    var el = document.querySelector('.rtp-page');\n    if (el) {\n      while ((el = el.parentElement) && el.tagName !== 'HTML') {\n        el.style.overflow = 'visible';\n        el.style.overflowX = 'visible';\n      }\n    }\n  });\n\n  /* Gallery */\n  window.rtpSelectVariant = function(idx) {\n    rtpCurrentIdx = idx;\n    var main = document.getElementById('rtpMainDisplay');\n    var thumbs = document.querySelectorAll('.rtp-thumb');\n    main.style.opacity = 0.5;\n    setTimeout(function() { main.src = rtpImages[idx]; main.style.opacity = 1; }, 150);\n    thumbs.forEach(function(t) { t.classList.remove('active'); });\n    thumbs[idx].classList.add('active');\n  };\n\n  /* Lightbox */\n  window.rtpOpenLightbox = function() {\n    var lb = document.getElementById('rtpLightbox');\n    document.getElementById('rtpLightboxImg').src = rtpImages[rtpCurrentIdx];\n    lb.classList.add('active');\n    document.body.style.overflow = 'hidden';\n  };\n  window.rtpCloseLightbox = function() {\n    document.getElementById('rtpLightbox').classList.remove('active');\n    document.body.style.overflow = '';\n  };\n  window.rtpNavLightbox = function(dir) {\n    rtpCurrentIdx += dir;\n    if (rtpCurrentIdx >= rtpImages.length) rtpCurrentIdx = 0;\n    if (rtpCurrentIdx < 0) rtpCurrentIdx = rtpImages.length - 1;\n    var img = document.getElementById('rtpLightboxImg');\n    img.style.opacity = 0.5;\n    setTimeout(function() { img.src = rtpImages[rtpCurrentIdx]; img.style.opacity = 1; }, 150);\n    rtpSelectVariant(rtpCurrentIdx);\n  };\n\n  /* Keyboard */\n  document.addEventListener('keydown', function(e) {\n    var lb = document.getElementById('rtpLightbox');\n    if (lb.classList.contains('active')) {\n      if (e.key === 'Escape') rtpCloseLightbox();\n      if (e.key === 'ArrowRight') rtpNavLightbox(1);\n      if (e.key === 'ArrowLeft') rtpNavLightbox(-1);\n    }\n  });\n\n  /* ── COLOR PALETTE ── */\n  var colors = [\n    { hex: '#FFFFFF', name: 'white' },\n    { hex: '#F5F1E8', name: 'off-white' },\n    { hex: '#D9D9D9', name: 'light grey' },\n    { hex: '#808080', name: 'grey' },\n    { hex: '#000000', name: 'black' },\n    { hex: '#FF2D2D', name: 'bright red' },\n    { hex: '#C8102E', name: 'sport red' },\n    { hex: '#800020', name: 'burgundy' },\n    { hex: '#5C1A1B', name: 'maroon' },\n    { hex: '#0057FF', name: 'royal blue' },\n    { hex: '#001F5B', name: 'navy' },\n    { hex: '#6EC6FF', name: 'sky blue' },\n    { hex: '#A7D8FF', name: 'ice blue' },\n    { hex: '#00A651', name: 'emerald' },\n    { hex: '#1F5F3B', name: 'forest green' },\n    { hex: '#C7FF00', name: 'volt' },\n    { hex: '#FFD200', name: 'athletic yellow' },\n    { hex: '#FF8C00', name: 'orange' },\n    { hex: '#FF4FA3', name: 'hot pink' },\n    { hex: '#7A3DB8', name: 'purple' },\n    { hex: '#4B1F6F', name: 'dark purple' },\n    { hex: '#00AFAF', name: 'teal' },\n    { hex: '#C4A46B', name: 'gold' },\n    { hex: '#C0C0C0', name: 'silver' },\n    { hex: '#D8C3A5', name: 'sand' }\n  ];\n  var lightColors = ['#FFFFFF','#F5F1E8','#D9D9D9','#C7FF00','#FFD200','#A7D8FF','#6EC6FF','#C0C0C0','#D8C3A5'];\n\n  /* Build swatch grids */\n  document.querySelectorAll('.rtp-swatch-panel').forEach(function(panel) {\n    var propName = panel.getAttribute('data-for');\n    var row = document.querySelector('.rtp-color-row[data-rtp-property=\"' + propName + '\"]');\n    var selectedEl = row.querySelector('.rtp-color-selected');\n    var defaultColor = selectedEl.getAttribute('data-default');\n    var hiddenId = row.getAttribute('data-hidden');\n\n    var grid = document.createElement('div');\n    grid.className = 'rtp-swatch-grid';\n\n    colors.forEach(function(c) {\n      var swatch = document.createElement('div');\n      swatch.className = 'rtp-swatch';\n      swatch.setAttribute('data-color', c.hex);\n      swatch.setAttribute('data-name', c.name);\n      swatch.style.background = c.hex;\n      if (lightColors.indexOf(c.hex) !== -1) swatch.classList.add('rtp-swatch-light');\n      if (c.hex === defaultColor) swatch.classList.add('rtp-swatch-active');\n\n      swatch.addEventListener('click', function(e) {\n        e.stopPropagation();\n        grid.querySelectorAll('.rtp-swatch').forEach(function(s) { s.classList.remove('rtp-swatch-active'); });\n        swatch.classList.add('rtp-swatch-active');\n        selectedEl.querySelector('.rtp-color-preview').style.background = c.hex;\n        selectedEl.querySelector('.rtp-color-selected-label').textContent = c.name;\n        document.getElementById(hiddenId).value = c.hex;\n        setTimeout(function() {\n          panel.classList.remove('rtp-panel-open');\n          row.classList.remove('rtp-row-open');\n        }, 200);\n      });\n\n      grid.appendChild(swatch);\n    });\n\n    panel.appendChild(grid);\n\n    row.addEventListener('click', function() {\n      var isOpen = panel.classList.contains('rtp-panel-open');\n      document.querySelectorAll('.rtp-swatch-panel').forEach(function(p) { p.classList.remove('rtp-panel-open'); });\n      document.querySelectorAll('.rtp-color-row').forEach(function(r) { r.classList.remove('rtp-row-open'); });\n      if (!isOpen) {\n        panel.classList.add('rtp-panel-open');\n        row.classList.add('rtp-row-open');\n      }\n    });\n  });\n\n  /* ── KIT SELECTOR ── */\n  window.rtpSelectKit = function(type, el) {\n    document.querySelectorAll('.rtp-kit-option').forEach(function(o) { o.classList.remove('rtp-kit-active'); });\n    el.classList.add('rtp-kit-active');\n\n    var priceJersey = document.getElementById('rtpPriceJersey');\n    var priceKit = document.getElementById('rtpPriceKit');\n    var perks = document.getElementById('rtpKitPerks');\n    var hidden = document.getElementById('rtpKitTypeValue');\n\n    if (type === 'fullkit') {\n      priceJersey.style.display = 'none';\n      priceKit.style.display = 'flex';\n      perks.style.display = 'block';\n      hidden.value = 'Full kit (jersey + shorts)';\n    } else {\n      priceJersey.style.display = 'flex';\n      priceKit.style.display = 'none';\n      perks.style.display = 'none';\n      hidden.value = 'Jersey only';\n    }\n  };\n\n  /* ── FILE UPLOAD ── */\n  window.rtpShowFile = function(input, statusId) {\n    if (input.files[0]) {\n      document.getElementById(statusId).innerHTML = '<i class=\"fas fa-check\"></i> ' + input.files[0].name;\n    }\n  };\n})();\n</script>",
  "detail_url": "https://us.momuto.com/pages/detail/6492219"
}
