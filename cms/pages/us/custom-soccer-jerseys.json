  "content": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebPage\",\n  \"name\": \"Custom Soccer Jerseys & Uniforms — Design Your Team's Kit | MOMUTO\",\n  \"description\": \"Design custom soccer jerseys and uniforms online with MOMUTO's free 3D tool. No minimum order, full dye-sublimation, youth-to-adult sizing, professional design mockups in 1-2 days.\",\n  \"url\": \"/pages/custom-soccer-jerseys\",\n  \"datePublished\": \"2026-06-17\",\n  \"dateModified\": \"2026-06-17\",\n  \"inLanguage\": \"en-US\",\n  \"speakable\": {\n    \"@type\": \"SpeakableSpecification\",\n    \"cssSelector\": [\".sj-bluf\", \".sj-faq\"]\n  },\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"MOMUTO\",\n    \"url\": \"/\"\n  }\n}\n</script>\n<p></p>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"/\" },\n    { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Custom Soccer Jerseys & Uniforms\", \"item\": \"/pages/custom-soccer-jerseys\" }\n  ]\n}\n</script>\n<p></p>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is there a minimum order for custom soccer jerseys?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"No. MOMUTO has no minimum order. You can order a single custom soccer jersey or a full club kit of 100+. Pricing per jersey drops as the order grows, but there are no minimum-quantity surcharges or sample fees.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does delivery take?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Custom soccer jerseys and uniforms are delivered in 25-30 days worldwide (production plus shipping direct from the factory). Your free design mockup is ready in 1-2 days, and production does not start until you approve it.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I upload my own logo or team crest?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. You can upload your own club logo, crest, or sponsor artwork, and our design team will place it on the jersey. Because every kit is full dye-sublimation printed, logos and crests are printed into the fabric rather than sewn on, so there are no size or color limits.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What sizes are available — do you make youth soccer jerseys?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. MOMUTO makes both youth and adult sizes, so a club, academy, or family can order the same design across every age group. A full size guide with measurements is available before you order.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Are the jerseys sublimated or sewn?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"All MOMUTO soccer jerseys use full dye-sublimation printing, where the design is fused into the fabric. It never peels, cracks, or fades, and it allows unlimited colors, gradients, patterns, names, numbers, and crests at no extra cost — unlike sewn-on twill or heat-pressed numbers.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can each player have a different name and number?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. The whole team can order one design with a different name and number per player, at no extra charge. Sublimation printing means personalization is part of the print, not an add-on.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is the design service really free?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"The self-serve routes are free: a real-time 3D configurator with 30+ templates, and studio-designed Ready-to-Play models at a permanent 10% discount. Want our team to design it? Fully custom mockup in 1-2 days with revisions included — $15 deposit, fully credited to orders of 5+ jerseys.\"\n      }\n    }\n  ]\n}\n</script>\n<p></p>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Custom Soccer Jersey & Uniform\",\n  \"description\": \"Fully custom, full-sublimation soccer jersey and uniform. Polyester-elastane performance fabric, free 3D design tools, no minimum order, youth-to-adult sizing. Delivered worldwide in 25-30 days.\",\n  \"brand\": { \"@type\": \"Brand\", \"name\": \"MOMUTO\" },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\",\n    \"ratingValue\": 4.4,\n    \"reviewCount\": 17,\n    \"bestRating\": 5\n  },\n  \"offers\": {\n    \"@type\": \"AggregateOffer\",\n    \"priceCurrency\": \"USD\",\n    \"lowPrice\": 21.90,\n    \"highPrice\": 56.80,\n    \"offerCount\": 7,\n    \"availability\": \"https://schema.org/InStock\",\n    \"url\": \"/pages/request-custom-kit-design\",\n    \"priceValidUntil\": \"2026-12-31\"\n  },\n  \"additionalProperty\": [\n    { \"@type\": \"PropertyValue\", \"name\": \"Minimum Order\", \"value\": \"1 unit\" },\n    { \"@type\": \"PropertyValue\", \"name\": \"Design Service\", \"value\": \"Free 3D configurator + custom design ($15 deposit, credited to orders of 5+ jerseys)\" },\n    { \"@type\": \"PropertyValue\", \"name\": \"Fabric\", \"value\": \"Polyester-elastane performance blend\" },\n    { \"@type\": \"PropertyValue\", \"name\": \"Printing\", \"value\": \"Full dye-sublimation\" },\n    { \"@type\": \"PropertyValue\", \"name\": \"Sizing\", \"value\": \"Youth to adult\" },\n    { \"@type\": \"PropertyValue\", \"name\": \"Delivery\", \"value\": \"25-30 days worldwide\" }\n  ]\n}\n</script><link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Outfit:wght@300;400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"><link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n/* ===== GLOBAL RESETS ===== */\nhtml, body {\n  background-color: #0a0a0a !important;\n  color: #f5f5f5;\n}\nh1.title, .title, .page-title { display: none !important; }\n.container_wrapper, .page-width, .container, .main-content {\n  max-width: 100% !important; width: 100% !important;\n  padding: 0 !important; margin: 0 !important;\n  overflow: visible !important;\n}\n*, *::before, *::after { box-sizing: border-box; }\n\n/* ===== VARIABLES ===== */\n:root {\n  --mg-bg: #0a0a0a;\n  --mg-panel: #111;\n  --mg-card: #111;\n  --mg-border: rgba(255,255,255,0.06);\n  --mg-border-hover: rgba(255,255,255,0.12);\n  --mg-white: #f5f5f5;\n  --mg-muted: #a1a1aa;\n  --mg-dim: #71717a;\n  --mg-red: #c8352e;\n  --mg-red-hover: #e04038;\n  --font-display: 'Bebas Neue', sans-serif;\n  --font-body: 'Outfit', sans-serif;\n}\n\n/* ===== PAGE ===== */\n.sj-page {\n  font-family: var(--font-body);\n  background: var(--mg-bg);\n  color: var(--mg-white);\n  width: 100%;\n  padding-bottom: 80px;\n}\n.sj-container {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 0 40px;\n}\n\n/* ===== HERO ===== */\n.sj-hero {\n  background: var(--mg-bg);\n  border-bottom: 1px solid var(--mg-border);\n  padding: 64px 40px 56px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n/* Center the hero text regardless of the CMS .mo-editor-reset paragraph styles.\n   Scoped to .sj-hero so body paragraphs keep normal block flow + left alignment. */\n.sj-hero h1,\n.sj-hero .sj-badge,\n.sj-hero .sj-lede,\n.sj-hero .sj-trust { text-align: center; }\n.sj-badge {\n  display: inline-block;\n  font-family: var(--font-body);\n  font-size: 0.6rem;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--mg-red);\n  background: rgba(200,53,46,0.1);\n  border: 1px solid rgba(200,53,46,0.15);\n  padding: 6px 14px;\n  margin-bottom: 20px;\n}\n.sj-hero h1 {\n  font-family: var(--font-display);\n  font-size: clamp(2.2rem, 6vw, 4rem);\n  font-weight: 400;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  line-height: 0.98;\n  color: var(--mg-white);\n  margin: 0 auto 18px;\n  max-width: 14ch;\n}\n.sj-hero h1 .hl { color: var(--mg-red); }\n.sj-lede {\n  font-family: var(--font-body);\n  font-size: 1.05rem;\n  font-weight: 300;\n  color: var(--mg-muted);\n  line-height: 1.7;\n  max-width: 62ch;\n  margin: 0 auto 28px;\n}\n.sj-cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }\n.sj-btn {\n  display: inline-block;\n  background: var(--mg-red);\n  color: #fff;\n  font-family: var(--font-body);\n  font-weight: 800;\n  font-size: 0.82rem;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  padding: 16px 34px;\n  text-decoration: none;\n  border: 1px solid var(--mg-red);\n  transition: background 0.2s ease;\n}\n.sj-btn:hover { background: var(--mg-red-hover); border-color: var(--mg-red-hover); }\n.sj-btn.secondary {\n  background: transparent;\n  color: var(--mg-white);\n  border: 1px solid var(--mg-border-hover);\n}\n.sj-btn.secondary:hover { border-color: var(--mg-white); background: transparent; }\n\n/* ===== BLUF / QUICK FACTS ===== */\n.sj-bluf { padding: 40px 0 0; }\n.sj-bluf p {\n  font-family: var(--font-body);\n  font-size: 1rem;\n  font-weight: 300;\n  color: var(--mg-muted);\n  line-height: 1.8;\n  margin-bottom: 1.1em;\n}\n.sj-bluf p strong { color: var(--mg-white); font-weight: 600; }\n.sj-equiv {\n  background: var(--mg-panel);\n  border: 1px solid var(--mg-border);\n  border-left: 3px solid var(--mg-red);\n  padding: 18px 22px;\n  font-size: 0.92rem;\n  color: var(--mg-muted);\n  line-height: 1.7;\n  margin: 6px 0 0;\n}\n.sj-equiv strong { color: var(--mg-white); }\n\n.sj-facts {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n  gap: 14px;\n  margin: 36px 0 0;\n}\n.sj-fact {\n  background: rgba(255,255,255,0.03);\n  border: 1px solid var(--mg-border);\n  padding: 20px;\n}\n.sj-fact .k {\n  font-family: var(--font-display);\n  font-size: 1.7rem;\n  color: var(--mg-white);\n  line-height: 1;\n  letter-spacing: 0.02em;\n}\n.sj-fact .l {\n  font-size: 0.78rem;\n  color: var(--mg-muted);\n  margin-top: 8px;\n  line-height: 1.5;\n}\n\n/* ===== SECTION TITLES ===== */\n.sj-h2 {\n  font-family: var(--font-display);\n  font-size: clamp(1.6rem, 3vw, 2.2rem);\n  font-weight: 400;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--mg-white);\n  margin: 60px 0 18px 0;\n  line-height: 1;\n  padding-left: 16px;\n  border-left: 3px solid var(--mg-red);\n}\n.sj-p {\n  font-family: var(--font-body);\n  font-size: 0.95rem;\n  font-weight: 300;\n  color: var(--mg-muted);\n  line-height: 1.8;\n  margin-bottom: 1.2em;\n}\n.sj-p strong { color: var(--mg-white); font-weight: 600; }\n\n/* ===== COMPARISON TABLE ===== */\n.sj-table-wrap { overflow-x: auto; margin: 2em 0; border: 1px solid var(--mg-border); }\n.sj-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  background: var(--mg-card);\n}\n.sj-table thead tr { background: #000; }\n.sj-table th {\n  color: var(--mg-muted);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  font-size: 0.62rem;\n  padding: 18px 16px;\n  text-align: left;\n  border-bottom: 1px solid var(--mg-border);\n}\n.sj-table th:nth-child(2) { color: var(--mg-white); background: var(--mg-red); }\n.sj-table td {\n  border-bottom: 1px solid var(--mg-border);\n  padding: 14px 16px;\n  vertical-align: middle;\n  color: var(--mg-muted);\n  line-height: 1.4;\n}\n.sj-table td:first-child { font-weight: 600; color: var(--mg-white); font-size: 0.8rem; }\n.sj-table td:nth-child(2) {\n  font-weight: 700;\n  color: var(--mg-white);\n  background: rgba(200,53,46,0.05);\n  border-left: 1px solid rgba(200,53,46,0.2);\n  border-right: 1px solid rgba(200,53,46,0.2);\n}\n.sj-table tr:last-child td:nth-child(2) { border-bottom: 1px solid rgba(200,53,46,0.2); }\n.sj-table tr:hover td { background: rgba(255,255,255,0.02); }\n.sj-table tr:hover td:nth-child(2) { background: rgba(200,53,46,0.08); }\n.sj-check { color: #4ade80; font-weight: 700; }\n\n/* ===== USE CASES ===== */\n.sj-uc-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 16px;\n  margin: 1.5em 0;\n}\n.sj-uc {\n  background: var(--mg-panel);\n  border: 1px solid var(--mg-border);\n  padding: 24px;\n  transition: border-color 0.2s;\n}\n.sj-uc:hover { border-color: var(--mg-border-hover); }\n.sj-uc i { color: var(--mg-red); font-size: 1.2rem; margin-bottom: 12px; display: block; }\n.sj-uc h3 {\n  font-family: var(--font-body);\n  font-weight: 700;\n  font-size: 0.95rem;\n  color: var(--mg-white);\n  margin: 0 0 8px;\n}\n.sj-uc p { font-size: 0.84rem; color: var(--mg-muted); line-height: 1.6; margin: 0; }\n\n/* ===== FAQ ===== */\n.sj-faq { margin: 1.5em 0; }\n.sj-faq details {\n  border: 1px solid var(--mg-border);\n  border-left: 3px solid var(--mg-red);\n  background: var(--mg-panel);\n  margin-bottom: 10px;\n  padding: 0 22px;\n}\n.sj-faq summary {\n  font-family: var(--font-body);\n  font-weight: 600;\n  font-size: 0.95rem;\n  color: var(--mg-white);\n  padding: 18px 0;\n  cursor: pointer;\n  list-style: none;\n}\n.sj-faq summary::-webkit-details-marker { display: none; }\n.sj-faq summary::after { content: \"+\"; float: right; color: var(--mg-red); font-weight: 700; }\n.sj-faq details[open] summary::after { content: \"−\"; }\n.sj-faq details p {\n  font-size: 0.9rem;\n  color: var(--mg-muted);\n  line-height: 1.75;\n  margin: 0 0 18px;\n  font-weight: 300;\n}\n\n/* ===== TRUST ===== */\n.sj-trust {\n  text-align: center;\n  font-size: 0.8rem;\n  color: var(--mg-dim);\n  margin-top: 18px;\n  letter-spacing: 0.04em;\n}\n.sj-trust a { color: var(--mg-muted); text-decoration: underline; }\n\n/* ===== CTA BLOCK ===== */\n.sj-cta-block {\n  background: var(--mg-red);\n  padding: 60px 40px;\n  text-align: center;\n  margin: 64px 0 0;\n}\n.sj-cta-block h2 {\n  font-family: var(--font-display);\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  font-weight: 400;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: #fff;\n  line-height: 1;\n  margin: 0 0 12px;\n}\n.sj-cta-block p { color: rgba(255,255,255,0.85); font-size: 0.95rem; font-weight: 300; margin-bottom: 26px; }\n.sj-cta-block .sj-btn { background: #fff; color: #000; border-color: #fff; }\n.sj-cta-block .sj-btn:hover { background: #e5e5e5; }\n.sj-cta-block .sj-btn.secondary { background: transparent; color: #fff; border-color: rgba(255,255,255,0.5); }\n\n.sj-note { font-size: 0.75rem; color: var(--mg-dim); margin-top: 10px; font-weight: 300; }\n\n/* ===== RESPONSIVE ===== */\n@media (max-width: 768px) {\n  .sj-container { padding: 0 20px; }\n  .sj-hero { padding: 44px 20px 40px; }\n  .sj-table { font-size: 0.75rem; }\n  .sj-table th, .sj-table td { padding: 10px 10px; }\n  .sj-cta-block { padding: 40px 20px; }\n}\n</style>\n<div class=\"sj-page\">\n<div class=\"sj-hero\">\n<div class=\"sj-badge\">Custom Soccer Jerseys &amp; Uniforms</div>\n<h1>Design Your Team's <span class=\"hl\">Soccer Kit</span></h1>\n<p class=\"sj-lede\">Build a fully custom soccer jersey in our free 3D designer, or send us your idea and get a professional mockup back in 1–2 days. No minimum order, full-sublimation printing, and every size from youth to adult.</p>\n<div class=\"sj-cta-row\"><a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&amp;configId=ypi9qc1z&amp;suitName=mamuto3suit1&amp;lang=en&amp;langguage=en\" class=\"sj-btn\">Create Your Own Soccer Jersey Online — Free</a> <a href=\"/pages/request-custom-kit-design\" class=\"sj-btn secondary\">Request a Free Design</a></div>\n<p class=\"sj-trust\">Rated 4.4/5 on <a href=\"https://www.trustpilot.com/review/momuto.com\" rel=\"nofollow\">Trustpilot</a> — trusted by clubs, academies and leagues worldwide.</p>\n</div>\n<div class=\"sj-container\"><!-- BLUF -->\n<div class=\"sj-bluf\">\n<p>MOMUTO makes <strong>custom soccer jerseys and full uniforms</strong> for clubs, youth academies, rec leagues, college intramural teams, and corporate sides. Pick a template in the <strong>free 3D designer</strong> and order in minutes, or submit your brief and our team designs a custom kit for you — <strong>the design is always free</strong>. Every jersey is <strong>full dye-sublimation</strong> printed on a polyester-elastane performance fabric, with <strong>no minimum order</strong> (order 5 or 50), <strong>youth-to-adult sizing</strong>, and worldwide delivery in <strong>25–30 days</strong>.</p>\n<p class=\"sj-equiv\"><strong>Soccer or soccer — it's the same sport, and the same kit.</strong> MOMUTO works as both a soccer jersey maker and a soccer kit designer. Whatever you call it, you get the same fully custom jersey, shorts, and uniform built to your team's identity.</p>\n<div class=\"sj-facts\">\n<div class=\"sj-fact\">\n<div class=\"k\">No min.</div>\n<div class=\"l\">Order a single jersey or a full club — no minimum-quantity surcharges</div>\n</div>\n<div class=\"sj-fact\">\n<div class=\"k\">1–2 days</div>\n<div class=\"l\">Professional design mockup with revisions ($15 deposit, credited from 5 jerseys)</div>\n</div>\n<div class=\"sj-fact\">\n<div class=\"k\">25–30 days</div>\n<div class=\"l\">Worldwide delivery, direct from the factory</div>\n</div>\n<div class=\"sj-fact\">\n<div class=\"k\">Youth–adult</div>\n<div class=\"l\">One design across every age group for clubs and academies</div>\n</div>\n</div>\n</div>\n<!-- 3D TOOL -->\n<h2 class=\"sj-h2\">Design Your Own Soccer Jersey in 3D</h2>\n<p class=\"sj-p\">The fastest way to start is the free 3D soccer jersey designer. Choose from 30+ professional templates, set your colors, drop in your crest, sponsor logo, and player names and numbers, and rotate the kit in real time to see exactly how it will look. When you're happy, order straight from the tool — or hand it to our designers to refine. There's no charge to design and no commitment until you place an order. Prefer to start from an idea (even an AI concept)? See <a href=\"/pages/design-your-own-soccer-jersey\" style=\"color: #fff; text-decoration: underline;\">design your own soccer jersey</a>.</p>\n<div class=\"sj-cta-row\" style=\"justify-content: flex-start;\"><a id=\"jump3d\" href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&amp;configId=ypi9qc1z&amp;suitName=mamuto3suit1&amp;lang=en&amp;langguage=en\" class=\"sj-btn\">Open the 3D Designer</a> <a href=\"/pages/custom-kit-gallery\" class=\"sj-btn secondary\">See Real Team Kits</a></div>\n</div>\n<!-- TRUST / SOCIAL PROOF (adapted from homepage) -->\n<style>\n    .trust-proof {\n        width: 100vw;\n        position: relative;\n        left: 50%;\n        margin-left: -50vw;\n        background: #0a0a0a;\n        color: #f5f5f5;\n        padding: 6rem 0;\n        overflow: hidden;\n    }\n    .trust-container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }\n    .trust-header { text-align: center; margin-bottom: 4rem; }\n    .trust-title {\n        font-family: 'Bebas Neue', sans-serif;\n        font-size: 2.5rem;\n        font-weight: 400;\n        color: #f5f5f5;\n        margin-bottom: 1rem;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        line-height: 1;\n    }\n    .trust-subtitle {\n        font-family: 'Outfit', sans-serif;\n        font-size: 1.1rem;\n        color: #a1a1aa;\n        max-width: 600px;\n        margin: 0 auto;\n        font-weight: 300;\n    }\n    .trust-scroll {\n        display: flex;\n        gap: 1.5rem;\n        overflow-x: auto;\n        scroll-behavior: smooth;\n        scrollbar-width: none;\n        padding-bottom: 0.5rem;\n        -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);\n        mask-image: linear-gradient(to right, black 85%, transparent 100%);\n    }\n    .trust-scroll::-webkit-scrollbar { display: none; }\n    .trust-card {\n        flex: 0 0 calc((100% - 3 * 1.5rem) / 3.5);\n        background: #111;\n        border: 1px solid rgba(255,255,255,0.06);\n        transition: border-color 0.25s ease, transform 0.25s ease;\n        position: relative;\n        overflow: hidden;\n        cursor: default;\n    }\n    .trust-card:hover { border-color: rgba(255,255,255,0.12); transform: translateY(-4px); }\n    .trust-card-img-wrap { position: relative; aspect-ratio: 4/5; overflow: hidden; background-color: #0a0a0a; }\n    .trust-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }\n    .trust-card:hover .trust-card-img { transform: scale(1.05); }\n    .trust-card-overlay {\n        position: absolute;\n        bottom: 0; left: 0;\n        width: 100%; height: 50%;\n        background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);\n        display: flex;\n        flex-direction: column;\n        justify-content: flex-end;\n        padding: 1.5rem;\n    }\n    .trust-card-team {\n        font-family: 'Bebas Neue', sans-serif;\n        font-size: 1.4rem;\n        font-weight: 400;\n        letter-spacing: 0.03em;\n        line-height: 1.1;\n        text-transform: uppercase;\n        margin-bottom: 0.4rem;\n        color: #f5f5f5;\n    }\n    .trust-card-desc {\n        font-family: 'Outfit', sans-serif;\n        font-size: 0.82rem;\n        font-weight: 300;\n        line-height: 1.5;\n        color: #a1a1aa;\n    }\n    .trust-cta {\n        text-align: center;\n        display: flex;\n        flex-direction: column;\n        gap: 1.5rem;\n        align-items: center;\n        margin-top: 4rem