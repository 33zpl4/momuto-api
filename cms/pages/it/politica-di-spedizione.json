faqnav ul::-webkit-scrollbar{display:none}\nnav.faqnav li{list-style:none !important;display:block !important;flex-shrink:0}\nnav.faqnav li::marker{content:none}\nnav.faqnav a{display:block;padding:14px 12px;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);text-decoration:none;border-bottom:2px solid transparent;white-space:nowrap}\nnav.faqnav a:hover{color:var(--white);border-color:var(--red)}\n.sec{padding:3.5rem 0;scroll-margin-top:60px}\n.sec h2{font-size:clamp(1.8rem,4vw,2.4rem);margin-bottom:.4rem}\n.sec .lead{color:var(--muted);max-width:720px;margin:0 0 1.8rem;font-size:.95rem}\n.sec.alt{background:var(--panel);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}\n.faq details{border-top:1px solid rgba(255,255,255,.1)}\n.faq details:last-child{border-bottom:1px solid rgba(255,255,255,.1)}\n.faq summary{list-style:none;cursor:pointer;padding:18px 4px;font-size:1rem;font-weight:600;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:'+';font-size:24px;color:var(--red);font-weight:300;line-height:1;flex-shrink:0}\n.faq details[open] summary::after{content:'\\2013'}\n.faq .a{margin:0 4px 18px;font-size:.9rem;color:var(--muted);line-height:1.7;max-width:820px}\n.faq .a b{color:#e5e5e5;font-weight:600}\n.faq .a a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.tablewrap{overflow-x:auto;border:1px solid var(--border);background:var(--panel)}\ntable.ladder{width:100%;border-collapse:collapse;min-width:560px;font-size:.92rem}\ntable.ladder th{font-family:var(--fd);font-weight:400;font-size:1rem;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);text-align:left;padding:14px 16px;border-bottom:1px solid var(--border)}\ntable.ladder td{padding:13px 16px;border-bottom:1px solid var(--border);color:var(--white)}\ntable.ladder tr:last-child td{border-bottom:none}\ntable.ladder td:first-child{color:var(--muted)}\ntable.ladder tr.pop td{background:rgba(200,53,46,.08);color:#fff;font-weight:600}\ntable.ladder .pill{display:inline-block;margin-left:8px;background:var(--red);color:#fff;font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:3px 8px;vertical-align:middle}\nul.notes{list-style:none !important;margin:1.4rem 0 0 !important;padding:0 !important;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px 24px}\nul.notes > li{display:flex !important;list-style:none !important;gap:.6rem;align-items:flex-start;font-size:.86rem;color:var(--muted);line-height:1.55}\nul.notes > li::marker{content:none}\nul.notes > li .ck{color:var(--red);font-weight:700;flex-shrink:0}\nul.notes b{color:#e5e5e5;font-weight:600}\n.btn{display:inline-block;background:var(--red);color:#fff;padding:16px 40px;font-weight:700;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border:1px solid var(--red);transition:all .2s}\n.btn:hover{background:var(--red-h);transform:translateY(-2px)}\n.btn2{display:inline-block;background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.18);padding:14px 34px;font-weight:600;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:all .2s;margin-left:.6rem}\n.btn2:hover{border-color:var(--red);color:var(--red)}\n.cta-end{padding:4.5rem 1.5rem;text-align:center;background:var(--panel);border-top:1px solid var(--border)}\n.cta-end h2{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:1rem}\n.cta-end p{color:var(--muted);max-width:560px;margin:0 auto 2rem;font-size:.95rem}\n.mo-editor-reset .cta-end p{margin-inline:auto}\n.more{padding:2.5rem 1.5rem;text-align:center;font-size:.85rem;color:var(--dim)}\n.more a{color:var(--muted)}\n@media(max-width:520px){.btn2{margin-left:0;margin-top:.8rem}}\n\nul.timeline{list-style:none !important;margin:0 !important;padding:0 !important;max-width:820px}\nul.timeline > li{display:flex !important;list-style:none !important;gap:1.2rem;align-items:flex-start;padding:1.1rem 0;border-bottom:1px solid var(--border);font-size:.92rem;color:var(--muted);line-height:1.6}\nul.timeline > li::marker{content:none}\nul.timeline > li .d{font-family:var(--fd);font-size:1.35rem;color:var(--red);min-width:132px;line-height:1.15;flex-shrink:0}\nul.timeline > li strong{color:var(--white);font-weight:600}\ntable.ladder td .sub{display:block;font-size:.78rem;color:var(--dim)}\n.faq h3{font-size:1.4rem;margin:0 0 .6rem}\n@media(max-width:600px){ul.timeline > li{flex-direction:column;gap:.3rem}}\n</style>\n<div class=\"faqpage\">\n<section class=\"hero\">\n<div class=\"badge\">Spedizione e consegna</div>\n<h1 class=\"h1\">Dall'Ordine alla <span class=\"acc\">Tua Porta</span></h1>\n<p class=\"sub\">Cosa succede dopo il pagamento, quanto dura ogni passaggio, chi consegna dove e quanto costa. Più del 95 % degli ordini arriva entro la finestra di 25–30 giorni.</p>\n<div class=\"quick\"><div class=\"q\"><div class=\"k\">25–30 giorni</div><div class=\"l\">porta a porta</div></div><div class=\"q\"><div class=\"k\">Gratis da 50 €</div><div class=\"l\">3,90 € sotto</div></div><div class=\"q\"><div class=\"k\">Tracciata</div><div class=\"l\">numero di tracciamento via email alla partenza</div></div><div class=\"q\"><div class=\"k\">Dazi prepagati</div><div class=\"l\">nessuna sorpresa alla consegna</div></div></div>\n</section>\n\n<section class=\"sec\" id=\"timeline\">\n<div class=\"wrap\">\n<h2>La tempistica</h2>\n<p class=\"lead\">Le divise sono fatte su ordinazione, quindi il cronometro ha quattro parti. L'unica che controlli tu è la velocità con cui approvi il mockup.</p>\n<ul class=\"timeline\">\n<li><span class=\"d\">Giorno 0</span><span><strong>Ordine confermato.</strong> Paghi al checkout e ricevi un'email di conferma. Se qualcosa nel tuo design richiede una decisione, ti scriviamo — tieni d'occhio la casella di posta.</span></li>\n<li><span class=\"d\">Giorno 1–2</span><span><strong>Mockup di produzione, 24–48 h.</strong> Un designer pulisce stemma e sponsor, imposta nomi e numeri e ti invia il file esatto che andrà in stampa. Cambia qualsiasi cosa, gratis. <b>Non si stampa nulla finché non approvi.</b></span></li>\n<li><span class=\"d\">Giorno 3–14</span><span><strong>Produzione, 7–12 giorni.</strong> Sublimazione integrale sul misto poliestere-elastan, tagliata e cucita sulla taglia di ogni giocatore.</span></li>\n<li><span class=\"d\">Giorno 15–30</span><span><strong>Spedizione, 10–15 giorni.</strong> Tracciata, con il corriere della tua zona (tabella sotto). Ricevi il numero di tracciamento via email appena il pacco parte.</span></li>\n<li><span class=\"d\">Consegna</span><span><strong>Alla tua porta.</strong> I dazi sono prepagati da noi. Problemi con il pacco? Scrivi a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> entro 7 giorni con le foto.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"zones\">\n<div class=\"wrap\">\n<h2>Dove spediamo e quanto costa</h2>\n<p class=\"lead\">Una sola soglia: spedizione gratuita per ordini sopra i 50 €, 3,90 € sotto. Ogni zona è tracciata.</p>\n<div class=\"tablewrap\"><table class=\"ladder\">\n<thead><tr><th>Destinazione</th><th>Corriere</th><th>Costo di spedizione</th><th>Porta a porta</th></tr></thead>\n<tbody>\n<tr><td>Italia</td><td>Corriere certificato</td><td>3,90 € · <b>gratis da 50 €</b></td><td>25–30 giorni</td></tr>\n<tr><td>Regno Unito</td><td>Royal Mail</td><td>3,90 € · <b>gratis da 50 €</b></td><td>25–30 giorni</td></tr>\n<tr><td>Resto d'Europa e del mondo</td><td>Corriere internazionale certificato</td><td>3,90 € · <b>gratis da 50 €</b></td><td>25–30 giorni</td></tr>\n<tr><td>Stati Uniti</td><td>USPS <span class=\"sub\">ordina su <a href=\"https://us.momuto.com\">us.momuto.com</a> — prezzi in dollari</span></td><td>4,90 $ · <b>gratis da 59 $</b></td><td>25–30 giorni</td></tr>\n</tbody></table></div>\n<ul class=\"notes\">\n<li><span class=\"ck\">&check;</span><span><b>Corsia veloce: +59 € per ordine</b> — salta la coda di produzione e aggiunge priorità di spedizione; circa 7 giorni risparmiati.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Pianifica con 7–9 settimane</b> per una stagione o un torneo e conferma l'ordine 4–5 settimane prima; le squadre impiegano 2–3 settimane a decidere, più della produzione.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Il cronometro parte all'approvazione del mockup</b>, non al pagamento — approva in fretta, ricevi in fretta.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Dazi prepagati.</b> Se un corriere ti addebita comunque qualcosa, invia la ricevuta a <a href=\"mailto:orders@momuto.com\">orders@momuto.com</a> e te la rimborsiamo.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec\" id=\"questions\">\n<div class=\"wrap\">\n<h2>Domande sulla spedizione</h2>\n<div class=\"faq\">\n<details><summary>Posso tracciare il mio ordine?</summary><div class=\"a\">Sì. Ogni ordine parte tracciato; il numero arriva via email appena il pacco lascia il magazzino e puoi seguirlo sulla pagina del corriere e nella sezione Stato dell'ordine del tuo account.</div></details>\n<details><summary>Consegnate nella mia zona?</summary><div class=\"a\">In Italia consegna un corriere certificato; nel Regno Unito Royal Mail; nel resto del mondo un corriere internazionale certificato. I clienti in Spagna, Francia e Stati Uniti hanno corrieri e prezzi locali sul proprio store MOMUTO.</div></details>\n<details><summary>Pagherò dazi o tasse di importazione?</summary><div class=\"a\">No — <b>i dazi sono prepagati da MOMUTO</b>. Nel raro caso in cui un corriere ti chieda comunque di pagare, invia la ricevuta a <a href=\"mailto:orders@momuto.com\">orders@momuto.com</a> e ti rimborsiamo l'importo.</div></details>\n<details><summary>Potete garantire una data di consegna?</summary><div class=\"a\">Non possiamo garantire una data — la logistica globale ogni tanto slitta — ma più del 95 % degli ordini arriva entro 25–30 giorni, e la corsia veloce (+59 €) fa guadagnare circa una settimana. Dicci la tua scadenza prima di ordinare e ti diremo onestamente se è realistica.</div></details>\n<details><summary>Posso cambiare l'indirizzo di consegna?</summary><div class=\"a\">Prima che il pacco parta, sì — scrivi a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> con il numero d'ordine e lo aggiorniamo. Una volta affidato al corriere, chiederemo il reindirizzamento dove il servizio lo consente, senza poterlo promettere.</div></details>\n<details><summary>Il pacco è arrivato danneggiato o manca qualcosa</summary><div class=\"a\">Scrivi a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> entro 7 giorni dalla consegna con le foto del pacco e dei capi. Danni durante il trasporto e pezzi mancanti vengono sostituiti o rimborsati — vedi la <a href=\"/pages/politica-resi\">politica di resi e cambi</a>.</div></details>\n</div>\n</div>\n</section>\n\n<section class=\"cta-end\">\n<h2>Quando vuoi</h2>\n<p>Progettala tu in 3D, gratis — o mandaci la tua idea e un designer la costruisce. In entrambi i casi il mockup arriva entro 48 ore.</p>\n<a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&configId=ypi9qc1z&suitName=mamuto3suit1&lang=it&langguage=it\" class=\"btn\">Progetta in 3D — gratis</a>\n<a href=\"https://wa.me/34614625408\" class=\"btn2\">Chiedi su WhatsApp</a>\n</section>\n<div class=\"more\">Continua a esplorare: <a href=\"/pages/faq\">FAQ e prezzi</a> &middot; <a href=\"/pages/politica-resi\">resi e cambi</a> &middot; <a href=\"/pages/guida-alle-taglie\">guida alle taglie</a> &middot; <a href=\"/pages/collezione-ready-to-play\">design Ready to Play</a></div>\n</div>\n",
