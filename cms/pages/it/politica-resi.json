55,.1)}\n.faq details:last-child{border-bottom:1px solid rgba(255,255,255,.1)}\n.faq summary{list-style:none;cursor:pointer;padding:18px 4px;font-size:1rem;font-weight:600;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:'+';font-size:24px;color:var(--red);font-weight:300;line-height:1;flex-shrink:0}\n.faq details[open] summary::after{content:'\\2013'}\n.faq .a{margin:0 4px 18px;font-size:.9rem;color:var(--muted);line-height:1.7;max-width:820px}\n.faq .a b{color:#e5e5e5;font-weight:600}\n.faq .a a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.tablewrap{overflow-x:auto;border:1px solid var(--border);background:var(--panel)}\ntable.ladder{width:100%;border-collapse:collapse;min-width:560px;font-size:.92rem}\ntable.ladder th{font-family:var(--fd);font-weight:400;font-size:1rem;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);text-align:left;padding:14px 16px;border-bottom:1px solid var(--border)}\ntable.ladder td{padding:13px 16px;border-bottom:1px solid var(--border);color:var(--white)}\ntable.ladder tr:last-child td{border-bottom:none}\ntable.ladder td:first-child{color:var(--muted)}\ntable.ladder tr.pop td{background:rgba(200,53,46,.08);color:#fff;font-weight:600}\ntable.ladder .pill{display:inline-block;margin-left:8px;background:var(--red);color:#fff;font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:3px 8px;vertical-align:middle}\nul.notes{list-style:none !important;margin:1.4rem 0 0 !important;padding:0 !important;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px 24px}\nul.notes > li{display:flex !important;list-style:none !important;gap:.6rem;align-items:flex-start;font-size:.86rem;color:var(--muted);line-height:1.55}\nul.notes > li::marker{content:none}\nul.notes > li .ck{color:var(--red);font-weight:700;flex-shrink:0}\nul.notes b{color:#e5e5e5;font-weight:600}\n.btn{display:inline-block;background:var(--red);color:#fff;padding:16px 40px;font-weight:700;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border:1px solid var(--red);transition:all .2s}\n.btn:hover{background:var(--red-h);transform:translateY(-2px)}\n.btn2{display:inline-block;background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.18);padding:14px 34px;font-weight:600;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:all .2s;margin-left:.6rem}\n.btn2:hover{border-color:var(--red);color:var(--red)}\n.cta-end{padding:4.5rem 1.5rem;text-align:center;background:var(--panel);border-top:1px solid var(--border)}\n.cta-end h2{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:1rem}\n.cta-end p{color:var(--muted);max-width:560px;margin:0 auto 2rem;font-size:.95rem}\n.mo-editor-reset .cta-end p{margin-inline:auto}\n.more{padding:2.5rem 1.5rem;text-align:center;font-size:.85rem;color:var(--dim)}\n.more a{color:var(--muted)}\n@media(max-width:520px){.btn2{margin-left:0;margin-top:.8rem}}\n\nul.timeline{list-style:none !important;margin:0 !important;padding:0 !important;max-width:820px}\nul.timeline > li{display:flex !important;list-style:none !important;gap:1.2rem;align-items:flex-start;padding:1.1rem 0;border-bottom:1px solid var(--border);font-size:.92rem;color:var(--muted);line-height:1.6}\nul.timeline > li::marker{content:none}\nul.timeline > li .d{font-family:var(--fd);font-size:1.35rem;color:var(--red);min-width:132px;line-height:1.15;flex-shrink:0}\nul.timeline > li strong{color:var(--white);font-weight:600}\ntable.ladder td .sub{display:block;font-size:.78rem;color:var(--dim);font-weight:300}\ntable.ladder td b{color:var(--white);font-weight:600}\ntable.ladder td a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.cancel{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;max-width:1060px}\n.cancel .c{background:rgba(255,255,255,.03);border:1px solid var(--border);padding:20px 22px}\n.cancel .c h3{font-size:1.3rem;margin:0 0 .5rem;color:var(--white)}\n.cancel .c p{font-size:.88rem;color:var(--muted);line-height:1.6;margin:0}\n.cancel .c b{color:#e5e5e5;font-weight:600}\n.cancel .c a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.faq h3{font-size:1.4rem;margin:0 0 .6rem}\n@media(max-width:600px){ul.timeline > li{flex-direction:column;gap:.3rem}}\n</style>\n<div class=\"faqpage\">\n<section class=\"hero\">\n<div class=\"badge\">Resi e cambi</div>\n<h1 class=\"h1\">Se Qualcosa Non Va, <span class=\"acc\">Lo Sistemiamo</span></h1>\n<p class=\"sub\">Ogni divisa è stampata sul mockup che approvi, quindi non esistono cambio taglia o reso per ripensamento. Se un capo arriva difettoso, danneggiato o diverso da ciò che hai approvato, lo sostituiamo o lo rimborsiamo — incluse le spese di reso che hai pagato.</p>\n<div class=\"quick\"><div class=\"q\"><div class=\"k\">7 giorni</div><div class=\"l\">per segnalare un problema dopo la consegna</div></div><div class=\"q\"><div class=\"k\">Foto + RMA</div><div class=\"l\">nessun pacco torna indietro senza numero RMA</div></div><div class=\"q\"><div class=\"k\">14 giorni</div><div class=\"l\">rimborso dopo l'approvazione, sul metodo di pagamento originale</div></div><div class=\"q\"><div class=\"k\">Rimborso completo</div><div class=\"l\">annulla in qualsiasi momento prima che inizi la produzione</div></div></div>\n</section>\n\n<section class=\"sec\" id=\"covered\">\n<div class=\"wrap\">\n<h2>Cosa è coperto</h2>\n<p class=\"lead\">Un prodotto su misura non si può rivendere, quindi la politica è stretta ma ferma: se l'errore è nostro o del corriere, è a carico nostro.</p>\n<div class=\"tablewrap\"><table class=\"ladder\">\n<thead><tr><th>Situazione</th><th>Cosa facciamo</th></tr></thead>\n<tbody>\n<tr><td><b>Difetto di fabbricazione</b> <span class=\"sub\">cuciture allentate, difetti di stampa, materiale sbagliato</span></td><td>Sostituzione o rimborso completo, per la via più rapida</td></tr>\n<tr><td><b>Danneggiato nel trasporto</b> <span class=\"sub\">strappato, macchiato o bagnato all'arrivo</span></td><td>Sostituzione o rimborso completo; conserva l'imballaggio per il reclamo al corriere</td></tr>\n<tr><td><b>Diverso dal mockup approvato</b> <span class=\"sub\">colore, nome, numero o posizione del logo sbagliati</span></td><td>Ristampato sul mockup, gratis — o rimborsato</td></tr>\n<tr><td><b>Pezzi mancanti</b> <span class=\"sub\">il set di un giocatore non è nella scatola</span></td><td>Gli articoli mancanti vengono spediti senza costi</td></tr>\n<tr><td><b>Taglia sbagliata nella rosa</b></td><td>Non restituibile — le taglie si stampano come le hai inserite; controlla la <a href=\"/pages/guida-alle-taglie\">guida alle taglie</a> prima di ordinare</td></tr>\n<tr><td><b>Ripensamento a produzione avviata</b></td><td>Non restituibile — la divisa è stata fatta per te e non si può rivendere</td></tr>\n</tbody></table></div>\n<ul class=\"notes\">\n<li><span class=\"ck\">&check;</span><span><b>Il mockup è il contratto.</b> Non si stampa nulla finché non approvi il mockup finale, quindi ciò che hai approvato è ciò che ti dobbiamo.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Garanzia a vita sulla stampa.</b> La sublimazione è tinta nel tessuto — non si stacca, non si crepa e non sbiadisce con lavaggi normali. Se succede, è un difetto e lo sostituiamo.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Le spese di reso vengono rimborsate</b> quando il reso è approvato — non paghi mai per rispedire un nostro errore.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Nessun costo di restocking</b>, mai.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"process\">\n<div class=\"wrap\">\n<h2>Come funziona un reclamo</h2>\n<p class=\"lead\">Cinque passaggi, e la maggior parte dei reclami non arriva al quarto — una foto chiara di solito basta per ristampare o rimborsare senza che il pacco torni indietro.</p>\n<ul class=\"timeline\">\n<li><span class=\"d\">Entro 7 giorni</span><span><strong>Scrivici.</strong> Invia un'email a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> entro 7 giorni dalla consegna con il numero d'ordine, una breve descrizione e le foto del problema (e del pacco, se è arrivato danneggiato).</span></li>\n<li><span class=\"d\">1–2 giorni</span><span><strong>Valutiamo ed emettiamo un RMA.</strong> Un membro del team confronta le foto con il mockup approvato e ti risponde con un numero di autorizzazione al reso (RMA) e i passi successivi. Non spedire nulla prima di averlo.</span></li>\n<li><span class=\"d\">Se serve</span><span><strong>Rispediscilo.</strong> Alcuni casi richiedono un'ispezione nel nostro stabilimento. Spediscilo non usato, nell'imballaggio originale con le etichette, con tracciamento e indicando l'RMA — rimborsiamo la spedizione appena il reso è approvato.</span></li>\n<li><span class=\"d\">Alla ricezione</span><span><strong>Ispezione.</strong> Il capo restituito viene verificato rispetto al reclamo. I cambi partono solo dopo l'ispezione; le ristampe per mockup diverso iniziano subito.</span></li>\n<li><span class=\"d\">Entro 14 giorni</span><span><strong>Rimborso o sostituzione.</strong> I rimborsi approvati arrivano sul metodo di pagamento originale entro 14 giorni dall'approvazione, per l'intero importo più le spese di reso. Le sostituzioni rientrano in produzione e partono tracciate.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec\" id=\"cancellations\">\n<div class=\"wrap\">\n<h2>Annullamenti</h2>\n<p class=\"lead\">Puoi annullare con rimborso completo in qualsiasi momento prima che inizi la produzione.</p>\n<div class=\"cancel\">\n<div class=\"c\"><h3>Prima di approvare il mockup</h3><p><b>Rimborso completo</b>, senza domande. Rispondi all'email dell'ordine o scrivi a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a>.</p></div>\n<div class=\"c\"><h3>Dopo l'approvazione del mockup</h3><p>La produzione parte con l'approvazione e il tessuto viene stampato con il tuo design in pochi giorni, quindi l'ordine <b>non può più essere annullato</b> né modificato.</p></div>\n<div class=\"c\"><h3>Depositi di design</h3><p>Il deposito di design delle richieste 100 % personalizzate viene scalato per intero dagli ordini di 5+ maglie ed è gratuito per un ordine di squadra. Non è un acquisto e non viene rimborsato da solo.</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"questions\">\n<div class=\"wrap\">\n<h2>Domande sui resi</h2>\n<div class=\"faq\">\n<details><summary>Posso cambiare una maglia con un'altra taglia?</summary><div class=\"a\">No — i capi personalizzati sono stampati con nome, numero e taglia che hai inserito nella rosa, quindi un cambio taglia significherebbe ristampare a nostre spese. Usa la <a href=\"/pages/guida-alle-taglie\">guida alle taglie</a> prima di ordinare; nel dubbio, prendi una taglia in più. Se un capo misura diversamente dalla tabella pubblicata, è un difetto e lo sostituiamo.</div></details>\n<details><summary>Devo rispedire il capo?</summary><div class=\"a\">Spesso no. Per difetti visibili di stampa o cucitura bastano le foto e ristampiamo o rimborsiamo subito. Chiediamo il capo solo quando serve un'ispezione — e in quel caso rimborsiamo la spedizione appena il reclamo è approvato.</div></details>\n<details><summary>E se ho superato i 7 giorni?</summary><div class=\"a\">Scrivici comunque. La finestra lega i reclami alla consegna, ma un vero difetto scoperto al primo utilizzo resta un difetto. Valutiamo ogni caso.</div></details>\n<details><summary>Quanto ci vuole per una sostituzione?</summary><div class=\"a\">Una ristampa rientra in produzione (7–12 giorni) e parte tracciata (10–15 giorni), quindi conta 25–30 giorni porta a porta — lo stesso tempo dell'ordine originale. Dicci se c'è una partita in ballo e le daremo priorità.</div></details>\n<details><summary>Dove arriva il rimborso?</summary><div class=\"a\">Sul metodo di pagamento usato al checkout, entro 14 giorni dall'approvazione del reclamo. Se dopo quel termine non è arrivato, verifica prima con la tua banca — i tempi di accredito variano — poi scrivi a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> e lo rintracciamo.</div></details>\n<details><summary>Posso restituire una maglia Ready to Play che ho personalizzato?</summary><div class=\"a\">Valgono le stesse regole: è stata stampata sul tuo mockup approvato, quindi i resi riguardano solo difetti, danni o differenze rispetto al mockup.</div></details>\n</div>\n</div>\n</section>\n\n<section class=\"cta-end\">\n<h2>Quando vuoi</h2>\n<p>Progettala tu in 3D, gratis — o mandaci la tua idea e un designer la costruisce. In entrambi i casi approvi un mockup prima che si stampi qualsiasi cosa.</p>\n<a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&configId=ypi9qc1z&suitName=mamuto3suit1&lang=it&langguage=it\" class=\"btn\">Progetta in 3D — gratis</a>\n<a href=\"https://wa.me/34614625408\" class=\"btn2\">Chiedi su WhatsApp</a>\n</section>\n<div class=\"more\">Continua a esplorare: <a href=\"/pages/faq\">FAQ e prezzi</a> &middot; <a href=\"/pages/politica-di-spedizione\">spedizione</a> &middot; <a href=\"/pages/guida-alle-taglie\">guida alle taglie</a> &middot; <a href=\"/pages/collezione-ready-to-play\">design Ready to Play</a></div>\n</div>\n",
