80&ndash;200</td>\n</tr>\n<tr>\n<td>2XL</td>\n<td>103&ndash;120</td>\n<td class=\"hide-sm\">115&ndash;120</td>\n<td>185&ndash;205</td>\n</tr>\n<tr>\n<td>3XL</td>\n<td>109&ndash;126</td>\n<td class=\"hide-sm\">121&ndash;126</td>\n<td>185&ndash;205</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- ── NIÑOS / JUVENIL ── -->\n<div class=\"sg-panel\" id=\"sg-kids\">\n<h2 class=\"sg-h2\">Camisetas de F&uacute;tbol &mdash; Ni&ntilde;os / Juvenil</h2>\n<div class=\"sg-table-wrap\">\n<div class=\"table-scroll-wrapper\" style=\"overflow-x: auto;\">\n<table class=\"sg-table\">\n<thead>\n<tr>\n<th>Talla</th>\n<th>Pecho (cm)</th>\n<th class=\"hide-sm\">Peso (kg)</th>\n<th>Altura (cm)</th>\n<th>Edad (aprox.)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>98/104</td>\n<td>54&ndash;58</td>\n<td class=\"hide-sm\">15&ndash;18</td>\n<td>96&ndash;104</td>\n<td class=\"sg-age\">3&ndash;4 a&ntilde;os</td>\n</tr>\n<tr>\n<td>110/116</td>\n<td>58&ndash;64</td>\n<td class=\"hide-sm\">18&ndash;22</td>\n<td>105&ndash;117</td>\n<td class=\"sg-age\">5&ndash;6 a&ntilde;os</td>\n</tr>\n<tr>\n<td>128</td>\n<td>64&ndash;70</td>\n<td class=\"hide-sm\">22&ndash;28</td>\n<td>123&ndash;128</td>\n<td class=\"sg-age\">7&ndash;8 a&ntilde;os</td>\n</tr>\n<tr>\n<td>140</td>\n<td>70&ndash;76</td>\n<td class=\"hide-sm\">28&ndash;36</td>\n<td>135&ndash;140</td>\n<td class=\"sg-age\">9&ndash;10 a&ntilde;os</td>\n</tr>\n<tr>\n<td>152</td>\n<td>76&ndash;82</td>\n<td class=\"hide-sm\">34&ndash;42</td>\n<td>147&ndash;152</td>\n<td class=\"sg-age\">11&ndash;12 a&ntilde;os</td>\n</tr>\n<tr>\n<td>164</td>\n<td>82&ndash;88</td>\n<td class=\"hide-sm\">40&ndash;52</td>\n<td>159&ndash;164</td>\n<td class=\"sg-age\">13&ndash;14 a&ntilde;os</td>\n</tr>\n<tr>\n<td>176</td>\n<td>88&ndash;94</td>\n<td class=\"hide-sm\">52&ndash;63</td>\n<td>170&ndash;176</td>\n<td class=\"sg-age\">15&ndash;16 a&ntilde;os</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<h2 class=\"sg-h2\">Pantalones Cortos de F&uacute;tbol &mdash; Ni&nti