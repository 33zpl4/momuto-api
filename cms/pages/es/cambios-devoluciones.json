lid var(--border);border-bottom:1px solid var(--border)}\n.faq details{border-top:1px solid rgba(255,255,255,.1)}\n.faq details:last-child{border-bottom:1px solid rgba(255,255,255,.1)}\n.faq summary{list-style:none;cursor:pointer;padding:18px 4px;font-size:1rem;font-weight:600;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:'+';font-size:24px;color:var(--red);font-weight:300;line-height:1;flex-shrink:0}\n.faq details[open] summary::after{content:'\\2013'}\n.faq .a{margin:0 4px 18px;font-size:.9rem;color:var(--muted);line-height:1.7;max-width:820px}\n.faq .a b{color:#e5e5e5;font-weight:600}\n.faq .a a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.tablewrap{overflow-x:auto;border:1px solid var(--border);background:var(--panel)}\ntable.ladder{width:100%;border-collapse:collapse;min-width:560px;font-size:.92rem}\ntable.ladder th{font-family:var(--fd);font-weight:400;font-size:1rem;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);text-align:left;padding:14px 16px;border-bottom:1px solid var(--border)}\ntable.ladder td{padding:13px 16px;border-bottom:1px solid var(--border);color:var(--white)}\ntable.ladder tr:last-child td{border-bottom:none}\ntable.ladder td:first-child{color:var(--muted)}\ntable.ladder tr.pop td{background:rgba(200,53,46,.08);color:#fff;font-weight:600}\ntable.ladder .pill{display:inline-block;margin-left:8px;background:var(--red);color:#fff;font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:3px 8px;vertical-align:middle}\nul.notes{list-style:none !important;margin:1.4rem 0 0 !important;padding:0 !important;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px 24px}\nul.notes > li{display:flex !important;list-style:none !important;gap:.6rem;align-items:flex-start;font-size:.86rem;color:var(--muted);line-height:1.55}\nul.notes > li::marker{content:none}\nul.notes > li .ck{color:var(--red);font-weight:700;flex-shrink:0}\nul.notes b{color:#e5e5e5;font-weight:600}\n.btn{display:inline-block;background:var(--red);color:#fff;padding:16px 40px;font-weight:700;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border:1px solid var(--red);transition:all .2s}\n.btn:hover{background:var(--red-h);transform:translateY(-2px)}\n.btn2{display:inline-block;background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.18);padding:14px 34px;font-weight:600;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:all .2s;margin-left:.6rem}\n.btn2:hover{border-color:var(--red);color:var(--red)}\n.cta-end{padding:4.5rem 1.5rem;text-align:center;background:var(--panel);border-top:1px solid var(--border)}\n.cta-end h2{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:1rem}\n.cta-end p{color:var(--muted);max-width:560px;margin:0 auto 2rem;font-size:.95rem}\n.mo-editor-reset .cta-end p{margin-inline:auto}\n.more{padding:2.5rem 1.5rem;text-align:center;font-size:.85rem;color:var(--dim)}\n.more a{color:var(--muted)}\n@media(max-width:520px){.btn2{margin-left:0;margin-top:.8rem}}\n\nul.timeline{list-style:none !important;margin:0 !important;padding:0 !important;max-width:820px}\nul.timeline > li{display:flex !important;list-style:none !important;gap:1.2rem;align-items:flex-start;padding:1.1rem 0;border-bottom:1px solid var(--border);font-size:.92rem;color:var(--muted);line-height:1.6}\nul.timeline > li::marker{content:none}\nul.timeline > li .d{font-family:var(--fd);font-size:1.35rem;color:var(--red);min-width:132px;line-height:1.15;flex-shrink:0}\nul.timeline > li strong{color:var(--white);font-weight:600}\ntable.ladder td .sub{display:block;font-size:.78rem;color:var(--dim);font-weight:300}\ntable.ladder td b{color:var(--white);font-weight:600}\ntable.ladder td a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.cancel{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;max-width:1060px}\n.cancel .c{background:rgba(255,255,255,.03);border:1px solid var(--border);padding:20px 22px}\n.cancel .c h3{font-size:1.3rem;margin:0 0 .5rem;color:var(--white)}\n.cancel .c p{font-size:.88rem;color:var(--muted);line-height:1.6;margin:0}\n.cancel .c b{color:#e5e5e5;font-weight:600}\n.cancel .c a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.faq h3{font-size:1.4rem;margin:0 0 .6rem}\n@media(max-width:600px){ul.timeline > li{flex-direction:column;gap:.3rem}}\n</style>\n<div class=\"faqpage\">\n<section class=\"hero\">\n<div class=\"badge\">Cambios y devoluciones</div>\n<h1 class=\"h1\">Si Algo Está <span class=\"acc\">Mal</span>, Lo Arreglamos</h1>\n<p class=\"sub\">Cada equipación se imprime según la maqueta que apruebas, así que no hay cambio de talla ni devolución por arrepentimiento. Si una prenda llega defectuosa, dañada o distinta de lo aprobado, la reemplazamos o la reembolsamos — incluido el envío de devolución que hayas pagado.</p>\n<div class=\"quick\"><div class=\"q\"><div class=\"k\">7 días</div><div class=\"l\">para avisar de un problema tras la entrega</div></div><div class=\"q\"><div class=\"k\">Fotos + RMA</div><div class=\"l\">ningún paquete vuelve sin número RMA</div></div><div class=\"q\"><div class=\"k\">14 días</div><div class=\"l\">reembolso tras la aprobación, al método de pago original</div></div><div class=\"q\"><div class=\"k\">Reembolso total</div><div class=\"l\">cancela en cualquier momento antes de que empiece la producción</div></div></div>\n</section>\n\n<section class=\"sec\" id=\"covered\">\n<div class=\"wrap\">\n<h2>Qué cubre</h2>\n<p class=\"lead\">Un producto hecho a medida no se puede revender, así que la política es estrecha pero firme: si el error es nuestro o del transportista, corre de nuestra cuenta.</p>\n<div class=\"tablewrap\"><table class=\"ladder\">\n<thead><tr><th>Situación</th><th>Qué hacemos</th></tr></thead>\n<tbody>\n<tr><td><b>Defecto de fabricación</b> <span class=\"sub\">costuras sueltas, fallos de estampado, material incorrecto</span></td><td>Reemplazo o reembolso total, por la vía más rápida</td></tr>\n<tr><td><b>Daño en el transporte</b> <span class=\"sub\">rasgado, manchado o mojado al llegar</span></td><td>Reemplazo o reembolso total; guarda el embalaje para la reclamación al transportista</td></tr>\n<tr><td><b>Distinta de la maqueta aprobada</b> <span class=\"sub\">color, nombre, número o posición del logo incorrectos</span></td><td>Se reimprime según la maqueta, gratis — o se reembolsa</td></tr>\n<tr><td><b>Faltan piezas</b> <span class=\"sub\">el conjunto de un jugador no viene en la caja</span></td><td>Enviamos lo que falta sin coste</td></tr>\n<tr><td><b>Talla equivocada en la plantilla</b></td><td>No se devuelve — las tallas se imprimen tal como las introdujiste; consulta la <a href=\"/pages/guia-tallas\">guía de tallas</a> antes de pedir</td></tr>\n<tr><td><b>Arrepentimiento con la producción ya iniciada</b></td><td>No se devuelve — la equipación se fabricó para ti y no se puede revender</td></tr>\n</tbody></table></div>\n<ul class=\"notes\">\n<li><span class=\"ck\">&check;</span><span><b>La maqueta es el contrato.</b> No se imprime nada hasta que apruebas la maqueta final, así que lo que aprobaste es lo que te debemos.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Garantía de por vida del estampado.</b> La sublimación se tiñe en el tejido — no se despega, ni se agrieta ni se destiñe con lavados normales. Si ocurre, es un defecto y lo reemplazamos.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>El envío de devolución se reembolsa</b> cuando se aprueba la devolución — nunca pagas por devolver un error nuestro.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Sin gastos de reposición</b>, nunca.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"process\">\n<div class=\"wrap\">\n<h2>Cómo funciona una reclamación</h2>\n<p class=\"lead\">Cinco pasos, y la mayoría de reclamaciones no llegan al cuarto — una foto clara suele bastar para reimprimir o reembolsar sin que el paquete vuelva.</p>\n<ul class=\"timeline\">\n<li><span class=\"d\">En 7 días</span><span><strong>Escríbenos.</strong> Envía un correo a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> en los 7 días siguientes a la entrega con tu número de pedido, una breve descripción y fotos del problema (y del paquete si llegó dañado).</span></li>\n<li><span class=\"d\">1–2 días</span><span><strong>Revisamos y emitimos un RMA.</strong> Comparamos las fotos con tu maqueta aprobada y te respondemos con un número de autorización de devolución (RMA) y los siguientes pasos. No envíes nada antes de tenerlo.</span></li>\n<li><span class=\"d\">Si hace falta</span><span><strong>Envíalo de vuelta.</strong> Algunos casos requieren inspeccionar la prenda en nuestra fábrica. Envíala sin usar, en su embalaje original con las etiquetas, con seguimiento y citando el RMA — te reembolsamos el envío al aprobar la devolución.</span></li>\n<li><span class=\"d\">Al recibirlo</span><span><strong>Inspección.</strong> Comprobamos la prenda devuelta contra la reclamación. Los cambios se envían solo tras completar la inspección; las reimpresiones por maqueta distinta empiezan de inmediato.</span></li>\n<li><span class=\"d\">En 14 días</span><span><strong>Reembolso o reemplazo.</strong> Los reembolsos aprobados van a tu método de pago original en 14 días desde la aprobación, por el importe completo más el envío de devolución. Los reemplazos vuelven a producción y se envían con seguimiento.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec\" id=\"cancellations\">\n<div class=\"wrap\">\n<h2>Cancelaciones</h2>\n<p class=\"lead\">Puedes cancelar con reembolso total en cualquier momento antes de que empiece la producción.</p>\n<div class=\"cancel\">\n<div class=\"c\"><h3>Antes de aprobar la maqueta</h3><p><b>Reembolso total</b>, sin preguntas. Responde al correo de tu pedido o escribe a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a>.</p></div>\n<div class=\"c\"><h3>Después de aprobar la maqueta</h3><p>La producción empieza con la aprobación y el tejido se imprime con tu diseño en pocos días, así que el pedido <b>ya no se puede cancelar</b> ni modificar.</p></div>\n<div class=\"c\"><h3>Depósitos de diseño</h3><p>El depósito de diseño de las peticiones 100 % personalizadas se descuenta íntegro en pedidos de 5+ camisetas y es gratis en un pedido de equipo. No es una compra y no se reembolsa por sí solo.</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"questions\">\n<div class=\"wrap\">\n<h2>Preguntas sobre devoluciones</h2>\n<div class=\"faq\">\n<details><summary>¿Puedo cambiar una camiseta por otra talla?</summary><div class=\"a\">No — las prendas personalizadas se imprimen con el nombre, número y talla que introdujiste en la plantilla, así que cambiar la talla supondría reimprimir a nuestro coste. Usa la <a href=\"/pages/guia-tallas\">guía de tallas</a> antes de pedir; en caso de duda, elige una talla más. Si una prenda mide distinto de lo que indica la tabla publicada, es un defecto y la reemplazamos.</div></details>\n<details><summary>¿Tengo que devolver la prenda?</summary><div class=\"a\">Muchas veces no. Para defectos visibles de estampado o costura bastan las fotos y reimprimimos o reembolsamos directamente. Solo pedimos la prenda cuando hace falta una inspección — y entonces te reembolsamos el envío al aprobar la reclamación.</div></details>\n<details><summary>¿Y si se me pasó el plazo de 7 días?</summary><div class=\"a\">Escríbenos igualmente. El plazo vincula las reclamaciones a la entrega, pero un defecto real detectado en el primer uso sigue siendo un defecto. Miramos cada caso.</div></details>\n<details><summary>¿Cuánto tarda un reemplazo?</summary><div class=\"a\">La reimpresión vuelve a producción (7–12 días) y se envía con seguimiento (10–15 días), así que cuenta con 25–30 días puerta a puerta — el mismo plazo que el pedido original. Dinos si hay un partido de por medio y le daremos prioridad.</div></details>\n<details><summary>¿Dónde llega el reembolso?</summary><div class=\"a\">Al método de pago usado en la compra, en los 14 días siguientes a la aprobación. Si pasado ese plazo no aparece, consulta primero con tu banco — los tiempos de abono varían — y luego escribe a <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> para que lo rastreemos.</div></details>\n<details><summary>¿Puedo devolver una camiseta Ready to Play que personalicé?</summary><div class=\"a\">Aplican las mismas reglas: se imprimió según tu maqueta aprobada, así que las devoluciones son solo por defecto, daño o diferencia con la maqueta.</div></details>\n</div>\n</div>\n</section>\n\n<section class=\"cta-end\">\n<h2>Cuando quieras</h2>\n<p>Diséñala tú en 3D, gratis — o envíanos tu idea y un diseñador la construye. En ambos casos apruebas una maqueta antes de imprimir nada.</p>\n<a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&configId=ypi9qc1z&suitName=mamuto3suit1&lang=es&langguage=es\" class=\"btn\">Diseñar en 3D — gratis</a>\n<a href=\"https://wa.me/34614625408\" class=\"btn2\">Preguntar por WhatsApp</a>\n</section>\n<div class=\"more\">Sigue explorando: <a href=\"/pages/preguntas-frecuentes\">FAQ y precios</a> &middot; <a href=\"/pages/envios-metodos-y-plazos\">envíos y plazos</a> &middot; <a href=\"/pages/guia-tallas\">guía de tallas</a> &middot; <a href=\"/pages/coleccion-ready-to-play\">diseños Ready to Play</a></div>\n</div>\n",
