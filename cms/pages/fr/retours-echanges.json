;gap:.6rem;align-items:flex-start;font-size:.86rem;color:var(--muted);line-height:1.55}\nul.notes > li::marker{content:none}\nul.notes > li .ck{color:var(--red);font-weight:700;flex-shrink:0}\nul.notes b{color:#e5e5e5;font-weight:600}\n.btn{display:inline-block;background:var(--red);color:#fff;padding:16px 40px;font-weight:700;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border:1px solid var(--red);transition:all .2s}\n.btn:hover{background:var(--red-h);transform:translateY(-2px)}\n.btn2{display:inline-block;background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.18);padding:14px 34px;font-weight:600;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:all .2s;margin-left:.6rem}\n.btn2:hover{border-color:var(--red);color:var(--red)}\n.cta-end{padding:4.5rem 1.5rem;text-align:center;background:var(--panel);border-top:1px solid var(--border)}\n.cta-end h2{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:1rem}\n.cta-end p{color:var(--muted);max-width:560px;margin:0 auto 2rem;font-size:.95rem}\n.mo-editor-reset .cta-end p{margin-inline:auto}\n.more{padding:2.5rem 1.5rem;text-align:center;font-size:.85rem;color:var(--dim)}\n.more a{color:var(--muted)}\n@media(max-width:520px){.btn2{margin-left:0;margin-top:.8rem}}\n\nul.timeline{list-style:none !important;margin:0 !important;padding:0 !important;max-width:820px}\nul.timeline > li{display:flex !important;list-style:none !important;gap:1.2rem;align-items:flex-start;padding:1.1rem 0;border-bottom:1px solid var(--border);font-size:.92rem;color:var(--muted);line-height:1.6}\nul.timeline > li::marker{content:none}\nul.timeline > li .d{font-family:var(--fd);font-size:1.35rem;color:var(--red);min-width:132px;line-height:1.15;flex-shrink:0}\nul.timeline > li strong{color:var(--white);font-weight:600}\ntable.ladder td .sub{display:block;font-size:.78rem;color:var(--dim);font-weight:300}\ntable.ladder td b{color:var(--white);font-weight:600}\ntable.ladder td a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.cancel{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;max-width:1060px}\n.cancel .c{background:rgba(255,255,255,.03);border:1px solid var(--border);padding:20px 22px}\n.cancel .c h3{font-size:1.3rem;margin:0 0 .5rem;color:var(--white)}\n.cancel .c p{font-size:.88rem;color:var(--muted);line-height:1.6;margin:0}\n.cancel .c b{color:#e5e5e5;font-weight:600}\n.cancel .c a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.faq h3{font-size:1.4rem;margin:0 0 .6rem}\n@media(max-width:600px){ul.timeline > li{flex-direction:column;gap:.3rem}}\n</style>\n<div class=\"faqpage\">\n<section class=\"hero\">\n<div class=\"badge\">Retours et échanges</div>\n<h1 class=\"h1\">Si Quelque Chose Ne Va Pas, <span class=\"acc\">On Répare</span></h1>\n<p class=\"sub\">Chaque tenue est imprimée selon la maquette que vous validez : pas d'échange de taille ni de retour pour changement d'avis. Si une pièce arrive défectueuse, abîmée ou différente de ce que vous avez validé, nous la remplaçons ou la remboursons — frais de retour compris.</p>\n<div class=\"quick\"><div class=\"q\"><div class=\"k\">7 jours</div><div class=\"l\">pour signaler un problème après la livraison</div></div><div class=\"q\"><div class=\"k\">Photos + RMA</div><div class=\"l\">aucun colis ne repart sans numéro RMA</div></div><div class=\"q\"><div class=\"k\">14 jours</div><div class=\"l\">remboursement après approbation, sur le moyen de paiement d'origine</div></div><div class=\"q\"><div class=\"k\">Remboursement intégral</div><div class=\"l\">annulez à tout moment avant le début de la production</div></div></div>\n</section>\n\n<section class=\"sec\" id=\"covered\">\n<div class=\"wrap\">\n<h2>Ce qui est couvert</h2>\n<p class=\"lead\">Un article fabriqué sur mesure ne peut pas être revendu : la politique est donc étroite mais ferme. Si l'erreur vient de nous ou du transporteur, elle est pour nous.</p>\n<div class=\"tablewrap\"><table class=\"ladder\">\n<thead><tr><th>Situation</th><th>Ce que nous faisons</th></tr></thead>\n<tbody>\n<tr><td><b>Défaut de fabrication</b> <span class=\"sub\">coutures lâches, défauts d'impression, mauvaise matière</span></td><td>Remplacement ou remboursement intégral, par la voie la plus rapide</td></tr>\n<tr><td><b>Abîmé pendant le transport</b> <span class=\"sub\">déchiré, taché ou mouillé à l'arrivée</span></td><td>Remplacement ou remboursement intégral ; gardez l'emballage pour la réclamation transporteur</td></tr>\n<tr><td><b>Différent de la maquette validée</b> <span class=\"sub\">couleur, nom, numéro ou placement du logo incorrects</span></td><td>Réimprimé selon la maquette, gratuitement — ou remboursé</td></tr>\n<tr><td><b>Pièces manquantes</b> <span class=\"sub\">la tenue d'un joueur n'est pas dans le carton</span></td><td>Les articles manquants sont envoyés sans frais</td></tr>\n<tr><td><b>Mauvaise taille saisie sur l'effectif</b></td><td>Non retournable — les tailles sont imprimées telles que saisies ; consultez le <a href=\"/pages/guide-des-tailles\">guide des tailles</a> avant de commander</td></tr>\n<tr><td><b>Changement d'avis après le début de la production</b></td><td>Non retournable — la tenue a été fabriquée pour vous et ne peut pas être revendue</td></tr>\n</tbody></table></div>\n<ul class=\"notes\">\n<li><span class=\"ck\">&check;</span><span><b>La maquette est le contrat.</b> Rien n'est imprimé avant que vous validiez la maquette finale : ce que vous avez validé est ce que nous vous devons.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Garantie à vie sur l'impression.</b> La sublimation est teinte dans le tissu — elle ne se décolle pas, ne craque pas et ne délave pas en lavage normal. Si c'est le cas, c'est un défaut et nous remplaçons.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Les frais de retour sont remboursés</b> quand un retour est approuvé — vous ne payez jamais pour renvoyer notre erreur.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Aucuns frais de restockage</b>, jamais.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"process\">\n<div class=\"wrap\">\n<h2>Comment se passe une réclamation</h2>\n<p class=\"lead\">Cinq étapes, et la plupart des réclamations n'atteignent jamais la quatrième : une photo nette suffit généralement pour réimprimer ou rembourser sans que le colis revienne.</p>\n<ul class=\"timeline\">\n<li><span class=\"d\">Sous 7 jours</span><span><strong>Écrivez-nous.</strong> Envoyez un e-mail à <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> dans les 7 jours suivant la livraison avec votre numéro de commande, une courte description et des photos du problème (et du colis s'il est arrivé abîmé).</span></li>\n<li><span class=\"d\">1–2 jours</span><span><strong>Nous examinons et émettons un RMA.</strong> Un membre de l'équipe compare les photos à votre maquette validée et vous répond avec un numéro d'autorisation de retour (RMA) et la marche à suivre. N'expédiez rien avant de l'avoir.</span></li>\n<li><span class=\"d\">Si nécessaire</span><span><strong>Renvoyez l'article.</strong> Certains cas exigent une inspection dans notre atelier. Expédiez-le non porté, dans son emballage d'origine avec les étiquettes, en suivi, en indiquant le RMA — nous remboursons l'affranchissement dès que le retour est approuvé.</span></li>\n<li><span class=\"d\">À réception</span><span><strong>Inspection.</strong> L'article retourné est vérifié par rapport à la réclamation. Les échanges partent seulement après l'inspection ; les réimpressions pour maquette différente démarrent immédiatement.</span></li>\n<li><span class=\"d\">Sous 14 jours</span><span><strong>Remboursement ou remplacement.</strong> Les remboursements approuvés sont versés sur votre moyen de paiement d'origine sous 14 jours après approbation, pour le montant total plus les frais de retour. Les remplacements repartent en production et sont expédiés en suivi.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec\" id=\"cancellations\">\n<div class=\"wrap\">\n<h2>Annulations</h2>\n<p class=\"lead\">Vous pouvez annuler avec remboursement intégral à tout moment avant le début de la production.</p>\n<div class=\"cancel\">\n<div class=\"c\"><h3>Avant la validation de la maquette</h3><p><b>Remboursement intégral</b>, sans question. Répondez à l'e-mail de commande ou écrivez à <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a>.</p></div>\n<div class=\"c\"><h3>Après la validation de la maquette</h3><p>La production démarre à la validation et le tissu est imprimé à votre design en quelques jours : la commande <b>ne peut plus être annulée</b> ni modifiée.</p></div>\n<div class=\"c\"><h3>Acomptes de design</h3><p>L'acompte de design des demandes 100 % sur mesure est déduit intégralement des commandes de 5 maillots ou plus et il est offert pour une commande d'équipe. Ce n'est pas un achat et il n'est pas remboursé seul.</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"questions\">\n<div class=\"wrap\">\n<h2>Questions sur les retours</h2>\n<div class=\"faq\">\n<details><summary>Puis-je échanger un maillot contre une autre taille ?</summary><div class=\"a\">Non — les articles personnalisés sont imprimés avec le nom, le numéro et la taille saisis sur l'effectif ; un échange de taille reviendrait à réimprimer à nos frais. Utilisez le <a href=\"/pages/guide-des-tailles\">guide des tailles</a> avant de commander ; en cas de doute, prenez la taille au-dessus. Si un vêtement ne correspond pas au tableau publié, c'est un défaut et nous le remplaçons.</div></details>\n<details><summary>Dois-je renvoyer l'article ?</summary><div class=\"a\">Souvent non. Pour les défauts visibles d'impression ou de couture, les photos suffisent et nous réimprimons ou remboursons directement. Nous demandons l'article seulement quand une inspection est nécessaire — et nous remboursons alors les frais de retour dès l'approbation.</div></details>\n<details><summary>Et si j'ai dépassé les 7 jours ?</summary><div class=\"a\">Écrivez-nous quand même. Le délai rattache les réclamations à la livraison, mais un vrai défaut constaté au premier port reste un défaut. Nous examinons chaque cas.</div></details>\n<details><summary>Combien de temps prend un remplacement ?</summary><div class=\"a\">Une réimpression repart en production (7–12 jours) et est expédiée en suivi (10–15 jours) : comptez 25–30 jours porte à porte, le même délai que la commande initiale. Dites-nous s'il y a un match en jeu et nous la passerons en priorité.</div></details>\n<details><summary>Où arrive mon remboursement ?</summary><div class=\"a\">Sur le moyen de paiement utilisé à la commande, sous 14 jours après approbation. S'il n'apparaît pas passé ce délai, vérifiez d'abord auprès de votre banque — les délais de crédit varient — puis écrivez à <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> pour que nous le tracions.</div></details>\n<details><summary>Puis-je retourner un maillot Ready to Play que j'ai personnalisé ?</summary><div class=\"a\">Les mêmes règles s'appliquent : il a été imprimé selon votre maquette validée, donc les retours concernent uniquement les défauts, les dommages ou un écart avec la maquette.</div></details>\n</div>\n</div>\n</section>\n\n<section class=\"cta-end\">\n<h2>Quand vous voulez</h2>\n<p>Concevez-la vous-même en 3D, gratuitement — ou envoyez-nous votre idée et un designer la construit. Dans les deux cas, vous validez une maquette avant toute impression.</p>\n<a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&configId=ypi9qc1z&suitName=mamuto3suit1&lang=fr&langguage=fr\" class=\"btn\">Concevoir en 3D — gratuit</a>\n<a href=\"https://wa.me/34614625408\" class=\"btn2\">Demander sur WhatsApp</a>\n</section>\n<div class=\"more\">Continuer : <a href=\"/pages/questions-frequentes\">FAQ et tarifs</a> &middot; <a href=\"/pages/politique-de-livraison\">livraison</a> &middot; <a href=\"/pages/guide-des-tailles\">guide des tailles</a> &middot; <a href=\"/pages/collection-ready-to-play\">designs Ready to Play</a></div>\n</div>\n",
