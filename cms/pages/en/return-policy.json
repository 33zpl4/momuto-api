from what you approved, we replace it or refund it — including the return shipping you paid.\"\n}\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I exchange a jersey for a different size?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"No — custom items are printed with the name, number and size you entered on the roster, so a size swap would mean reprinting at our cost. Use the size guide before ordering; if in doubt, size up. If a garment measures differently from the published chart, that is a defect and we replace it.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do I need to send the item back?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Often not. For visible print or seam defects, photos are enough and we reprint or refund straight away. We ask for the item back only when an inspection is needed — and then we refund the return postage once the claim is approved.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What if I missed the 7-day window?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Write to us anyway. The window keeps claims tied to delivery, but a genuine defect found on first wear is still a defect. We look at every case.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does a replacement take?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"A reprint re-enters production (7–12 days) and ships tracked (10–15 days), so plan on 25–30 days door to door — the same timeline as the original order. Tell us if there is a match deadline and we will prioritise it.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Where does my refund go?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"To the payment method used at checkout, within 14 days of the claim being approved. If it hasn't appeared after that, check with your bank first — posting times vary — then email customer@momuto.com and we will trace it.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I return a Ready to Play jersey I customised?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"The same rules apply: it was printed to your approved mockup, so returns are for defects, damage or a mismatch with the mockup only.\"\n      }\n    }\n  ]\n}\n</script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" /><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\" /><link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Outfit:wght@300;400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\" />\n<style>\n.title, .page-title { display: none !important; }\n:root { --bg:#0a0a0a; --panel:#111; --border:rgba(255,255,255,0.07); --white:#f5f5f5; --muted:#a1a1aa; --dim:#71717a; --red:#c8352e; --red-h:#e04038; --fd:'Bebas Neue',sans-serif; --fb:'Outfit',sans-serif; }\n*{margin:0;padding:0;box-sizing:border-box;-webkit-font-smoothing:antialiased}\nbody{font-family:var(--fb);font-weight:300;background:var(--bg);color:var(--white);line-height:1.65;overflow-x:hidden}\nh1,h2,h3{font-family:var(--fd);font-weight:400;text-transform:uppercase;letter-spacing:.03em;line-height:1}\n.acc{color:var(--red)}\n.faqpage{margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}\n.wrap{max-width:1060px;margin:0 auto;padding:0 1.5rem}\n.hero{padding:5rem 1.5rem 3.5rem;text-align:center;background:radial-gradient(circle at 50% 0%,#1a1a1a 0%,var(--bg) 70%);border-bottom:1px solid var(--border)}\n.badge{background:rgba(200,53,46,.1);border:1px solid rgba(200,53,46,.18);color:var(--red);font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.14em;padding:6px 14px;display:inline-block;margin-bottom:1.4rem}\n.h1{font-size:clamp(2.6rem,6vw,4.2rem);max-width:880px;margin:0 auto 1.2rem}\n.sub{color:var(--muted);font-size:1rem;max-width:660px;margin:0 auto;text-align:center}\n.mo-editor-reset .sub{margin-inline:auto}\n.quick{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;max-width:1060px;margin:2.4rem auto 0;padding:0 1.5rem;text-align:left}\n.mo-editor-reset .quick{margin-inline:auto}\n.q{background:rgba(255,255,255,.03);border:1px solid var(--border);padding:18px 20px}\n.q .k{font-family:var(--fd);font-size:1.7rem;color:var(--white);line-height:1;letter-spacing:.02em}\n.q .l{font-size:.78rem;color:var(--muted);margin-top:8px;line-height:1.5}\nnav.faqnav{position:sticky;top:0;z-index:5;background:rgba(10,10,10,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}\nnav.faqnav ul{list-style:none !important;margin:0 auto !important;padding:0 1rem !important;max-width:1060px;display:flex !important;gap:.2rem;overflow-x:auto;scrollbar-width:none}\nnav.faqnav ul::-webkit-scrollbar{display:none}\nnav.faqnav li{list-style:none !important;display:block !important;flex-shrink:0}\nnav.faqnav li::marker{content:none}\nnav.faqnav a{display:block;padding:14px 12px;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);text-decoration:none;border-bottom:2px solid transparent;white-space:nowrap}\nnav.faqnav a:hover{color:var(--white);border-color:var(--red)}\n.sec{padding:3.5rem 0;scroll-margin-top:60px}\n.sec h2{font-size:clamp(1.8rem,4vw,2.4rem);margin-bottom:.4rem}\n.sec .lead{color:var(--muted);max-width:720px;margin:0 0 1.8rem;font-size:.95rem}\n.sec.alt{background:var(--panel);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}\n.faq details{border-top:1px solid rgba(255,255,255,.1)}\n.faq details:last-child{border-bottom:1px solid rgba(255,255,255,.1)}\n.faq summary{list-style:none;cursor:pointer;padding:18px 4px;font-size:1rem;font-weight:600;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:'+';font-size:24px;color:var(--red);font-weight:300;line-height:1;flex-shrink:0}\n.faq details[open] summary::after{content:'\\2013'}\n.faq .a{margin:0 4px 18px;font-size:.9rem;color:var(--muted);line-height:1.7;max-width:820px}\n.faq .a b{color:#e5e5e5;font-weight:600}\n.faq .a a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.tablewrap{overflow-x:auto;border:1px solid var(--border);background:var(--panel)}\ntable.ladder{width:100%;border-collapse:collapse;min-width:560px;font-size:.92rem}\ntable.ladder th{font-family:var(--fd);font-weight:400;font-size:1rem;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);text-align:left;padding:14px 16px;border-bottom:1px solid var(--border)}\ntable.ladder td{padding:13px 16px;border-bottom:1px solid var(--border);color:var(--white)}\ntable.ladder tr:last-child td{border-bottom:none}\ntable.ladder td:first-child{color:var(--muted)}\ntable.ladder tr.pop td{background:rgba(200,53,46,.08);color:#fff;font-weight:600}\ntable.ladder .pill{display:inline-block;margin-left:8px;background:var(--red);color:#fff;font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:3px 8px;vertical-align:middle}\nul.notes{list-style:none !important;margin:1.4rem 0 0 !important;padding:0 !important;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px 24px}\nul.notes > li{display:flex !important;list-style:none !important;gap:.6rem;align-items:flex-start;font-size:.86rem;color:var(--muted);line-height:1.55}\nul.notes > li::marker{content:none}\nul.notes > li .ck{color:var(--red);font-weight:700;flex-shrink:0}\nul.notes b{color:#e5e5e5;font-weight:600}\n.btn{display:inline-block;background:var(--red);color:#fff;padding:16px 40px;font-weight:700;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border:1px solid var(--red);transition:all .2s}\n.btn:hover{background:var(--red-h);transform:translateY(-2px)}\n.btn2{display:inline-block;background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.18);padding:14px 34px;font-weight:600;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:all .2s;margin-left:.6rem}\n.btn2:hover{border-color:var(--red);color:var(--red)}\n.cta-end{padding:4.5rem 1.5rem;text-align:center;background:var(--panel);border-top:1px solid var(--border)}\n.cta-end h2{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:1rem}\n.cta-end p{color:var(--muted);max-width:560px;margin:0 auto 2rem;font-size:.95rem}\n.mo-editor-reset .cta-end p{margin-inline:auto}\n.more{padding:2.5rem 1.5rem;text-align:center;font-size:.85rem;color:var(--dim)}\n.more a{color:var(--muted)}\n@media(max-width:520px){.btn2{margin-left:0;margin-top:.8rem}}\n\nul.timeline{list-style:none !important;margin:0 !important;padding:0 !important;max-width:820px}\nul.timeline > li{display:flex !important;list-style:none !important;gap:1.2rem;align-items:flex-start;padding:1.1rem 0;border-bottom:1px solid var(--border);font-size:.92rem;color:var(--muted);line-height:1.6}\nul.timeline > li::marker{content:none}\nul.timeline > li .d{font-family:var(--fd);font-size:1.35rem;color:var(--red);min-width:132px;line-height:1.15;flex-shrink:0}\nul.timeline > li strong{color:var(--white);font-weight:600}\ntable.ladder td .sub{display:block;font-size:.78rem;color:var(--dim);font-weight:300}\ntable.ladder td b{color:var(--white);font-weight:600}\ntable.ladder td a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.cancel{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;max-width:1060px}\n.cancel .c{background:rgba(255,255,255,.03);border:1px solid var(--border);padding:20px 22px}\n.cancel .c h3{font-size:1.3rem;margin:0 0 .5rem;color:var(--white)}\n.cancel .c p{font-size:.88rem;color:var(--muted);line-height:1.6;margin:0}\n.cancel .c b{color:#e5e5e5;font-weight:600}\n.cancel .c a{color:var(--white);border-bottom:1px solid var(--red);text-decoration:none}\n.faq h3{font-size:1.4rem;margin:0 0 .6rem}\n@media(max-width:600px){ul.timeline > li{flex-direction:column;gap:.3rem}}\n</style>\n<div class=\"faqpage\">\n<section class=\"hero\">\n<div class=\"badge\">Returns &amp; exchanges</div>\n<h1 class=\"h1\">If Something Is <span class=\"acc\">Wrong</span>, We Fix It</h1>\n<p class=\"sub\">Every kit is printed to your approved mockup, so there is no size-swap or change-of-mind return. If a piece arrives defective, damaged or different from what you approved, we replace it or refund it — including the return shipping you paid.</p>\n<div class=\"quick\"><div class=\"q\"><div class=\"k\">7 days</div><div class=\"l\">to report an issue after delivery</div></div><div class=\"q\"><div class=\"k\">Photos + RMA</div><div class=\"l\">no parcel goes back without an RMA number</div></div><div class=\"q\"><div class=\"k\">14 days</div><div class=\"l\">refund after approval, to the original payment</div></div><div class=\"q\"><div class=\"k\">Full refund</div><div class=\"l\">cancel any time before production starts</div></div></div>\n</section>\n\n<section class=\"sec\" id=\"covered\">\n<div class=\"wrap\">\n<h2>What is covered</h2>\n<p class=\"lead\">Custom-made goods can't be resold, so the policy is narrow but firm: if it's our mistake or the carrier's, it's on us.</p>\n<div class=\"tablewrap\"><table class=\"ladder\">\n<thead><tr><th>Situation</th><th>What we do</th></tr></thead>\n<tbody>\n<tr><td><b>Manufacturing defect</b> <span class=\"sub\">loose seams, print flaws, wrong material</span></td><td>Replacement or full refund, our choice of the fastest route</td></tr>\n<tr><td><b>Damaged in transit</b> <span class=\"sub\">torn, stained or wet on arrival</span></td><td>Replacement or full refund; keep the packaging for the carrier claim</td></tr>\n<tr><td><b>Differs from the approved mockup</b> <span class=\"sub\">wrong colour, name, number, logo placement</span></td><td>Reprinted to the mockup, free — or refunded</td></tr>\n<tr><td><b>Missing pieces</b> <span class=\"sub\">one player's set not in the box</span></td><td>Missing items sent at no cost</td></tr>\n<tr><td><b>Wrong size chosen on the roster</b></td><td>Not returnable — sizes are printed as you entered them; check the <a href=\"/pages/size-guide\">size guide</a> before ordering</td></tr>\n<tr><td><b>Change of mind after production started</b></td><td>Not returnable — the kit was made for you and can't be resold</td></tr>\n</tbody></table></div>\n<ul class=\"notes\">\n<li><span class=\"ck\">&check;</span><span><b>The mockup is the contract.</b> Nothing is printed until you approve the final mockup, so what you approved is what we owe you.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Lifetime print guarantee.</b> Sublimation is dyed into the fabric — it can't peel, crack or fade under normal washing. If it does, that's a defect and we replace it.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>Return shipping is refunded</b> when a return is approved — you never pay to send back our mistake.</span></li>\n<li><span class=\"ck\">&check;</span><span><b>No restocking fee</b>, ever.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"process\">\n<div class=\"wrap\">\n<h2>How a claim works</h2>\n<p class=\"lead\">Five steps, and most claims never reach step four — a clear photo is usually enough for us to reprint or refund without the parcel coming back.</p>\n<ul class=\"timeline\">\n<li><span class=\"d\">Within 7 days</span><span><strong>Write to us.</strong> Email <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> within 7 days of delivery with your order number, a short description and photos of the issue (and of the parcel if it arrived damaged).</span></li>\n<li><span class=\"d\">1–2 days</span><span><strong>We review and issue an RMA.</strong> A team member checks the photos against your approved mockup and replies with a Return Merchandise Authorisation number and next steps. Please don't ship anything back before you have it.</span></li>\n<li><span class=\"d\">If needed</span><span><strong>Send it back.</strong> Some cases need the item at our production facility for inspection. Ship it unused, in its original packaging with tags attached, tracked, quoting the RMA — we refund the postage once the return is approved.</span></li>\n<li><span class=\"d\">On receipt</span><span><strong>Inspection.</strong> The returned item is checked against the claim. Exchanges ship only after the inspection is complete; reprints for mockup mismatches start immediately.</span></li>\n<li><span class=\"d\">Within 14 days</span><span><strong>Refund or replacement.</strong> Approved refunds go to your original payment method within 14 days of approval, for the full amount paid plus any return shipping. Replacements re-enter production and ship tracked.</span></li>\n</ul>\n</div>\n</section>\n\n<section class=\"sec\" id=\"cancellations\">\n<div class=\"wrap\">\n<h2>Cancellations</h2>\n<p class=\"lead\">You can cancel for a full refund at any point before production starts.</p>\n<div class=\"cancel\">\n<div class=\"c\"><h3>Before you approve the mockup</h3><p><b>Full refund</b>, no questions. Reply to your order email or write to <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a>.</p></div>\n<div class=\"c\"><h3>After mockup approval</h3><p>Production starts on approval and the fabric is printed to your design within days, so the order <b>can no longer be cancelled</b> or changed.</p></div>\n<div class=\"c\"><h3>Design deposits</h3><p>The design deposit on 100% custom requests is credited in full to orders of 5+ jerseys and is free for a team order. It is not a purchase and is not refunded on its own.</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"sec alt\" id=\"questions\">\n<div class=\"wrap\">\n<h2>Questions about returns</h2>\n<div class=\"faq\">\n<details><summary>Can I exchange a jersey for a different size?</summary><div class=\"a\">No — custom items are printed with the name, number and size you entered on the roster, so a size swap would mean reprinting at our cost. Use the <a href=\"/pages/size-guide\">size guide</a> before ordering; if in doubt, size up. If a garment measures differently from the published chart, that is a defect and we replace it.</div></details>\n<details><summary>Do I need to send the item back?</summary><div class=\"a\">Often not. For visible print or seam defects, photos are enough and we reprint or refund straight away. We ask for the item back only when an inspection is needed — and then we refund the return postage once the claim is approved.</div></details>\n<details><summary>What if I missed the 7-day window?</summary><div class=\"a\">Write to us anyway. The window keeps claims tied to delivery, but a genuine defect found on first wear is still a defect. We look at every case.</div></details>\n<details><summary>How long does a replacement take?</summary><div class=\"a\">A reprint re-enters production (7–12 days) and ships tracked (10–15 days), so plan on 25–30 days door to door — the same timeline as the original order. Tell us if there is a match deadline and we will prioritise it.</div></details>\n<details><summary>Where does my refund go?</summary><div class=\"a\">To the payment method used at checkout, within 14 days of the claim being approved. If it hasn't appeared after that, check with your bank first — posting times vary — then email <a href=\"mailto:customer@momuto.com\">customer@momuto.com</a> and we will trace it.</div></details>\n<details><summary>Can I return a Ready to Play jersey I customised?</summary><div class=\"a\">The same rules apply: it was printed to your approved mockup, so returns are for defects, damage or a mismatch with the mockup only.</div></details>\n</div>\n</div>\n</section>\n\n<section class=\"cta-end\">\n<h2>Whenever you're ready</h2>\n<p>Design it yourself in 3D, free — or send us your idea and a designer builds it. Either way you approve a mockup before anything prints.</p>\n<a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&configId=ypi9qc1z&suitName=mamuto3suit1&lang=en&langguage=en\" class=\"btn\">Design in 3D — free</a>\n<a href=\"https://wa.me/34614625408\" class=\"btn2\">Ask on WhatsApp</a>\n</section>\n<div class=\"more\">Keep exploring: <a href=\"/pages/faq\">FAQ &amp; prices</a> &middot; <a href=\"/pages/shipping-policy\">shipping &amp; delivery</a> &middot; <a href=\"/pages/size-guide\">size guide</a> &middot; <a href=\"/pages/ready-to-play\">Ready to Play designs</a></div>\n</div>\n",
