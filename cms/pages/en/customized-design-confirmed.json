  "content": "<link href=\"https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,700;0,800;1,800&amp;display=swap\" rel=\"stylesheet\" /><link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n<style>\n  :root {\n    --bg-white: #ffffff;\n    --bg-black: #000000;\n    --nike-grey: #111111;\n    --text-grey: #71717a;\n    --accent-red: #e2214b;\n    --border-soft: rgba(255,255,255,0.10);\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    font-family: 'Jost', sans-serif;\n    background: var(--bg-white);\n    color: #000;\n    line-height: 1.2;\n    overflow-x: hidden;\n  }\n\n  .title { display: none; }\n  .uppercase { text-transform: uppercase; }\n  .italic { font-style: italic; }\n\n  /* ===== HERO ===== */\n  header.hero {\n    padding: 7.5rem 20px 3.5rem;\n    text-align: center;\n    background: var(--bg-white);\n  }\n\n  .status-badge {\n    display: inline-block;\n    padding: 6px 12px;\n    background: #000;\n    color: #fff;\n    font-weight: 800;\n    font-size: 0.75rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    margin-bottom: 2rem;\n  }\n\n  .hero h1 {\n    font-size: clamp(3rem, 8vw, 6rem);\n    font-weight: 800;\n    line-height: 0.85;\n    letter-spacing: -0.05em;\n    text-transform: uppercase;\n    font-style: italic;\n    margin-bottom: 1rem;\n  }\n\n  .hero h3 {\n    font-size: 1.05rem;\n    font-weight: 400;\n    color: var(--text-grey);\n    max-width: 560px;\n    margin: 0 auto;\n    line-height: 1.45;\n  }\n\n  /* ===== FULL-WIDTH DARK SECTION ===== */\n  .dark-section {\n    background: var(--bg-black);\n    color: #fff;\n    padding: 0 0 5rem;\n  }\n\n  .activation-container {\n    max-width: 940px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n\n  /* ===== MAIN CARD ===== */\n  .main-card {\n    background: var(--nike-grey);\n    padding: 62px 40px;\n    text-align: center;\n    position: relative;\n    transform: translateY(-18px);\n  }\n\n  .main-card .lead {\n    color: rgba(255,255,255,0.75);\n    font-size: 1.05rem;\n    max-width: 620px;\n    margin: 0 auto 50px;\n    line-height: 1.55;\n    border-bottom: 1px solid rgba(255,255,255,0.1);\n    padding-bottom: 40px;\n  }\n\n  /* ===== TIMELINE ===== */\n  .timeline-section {\n    text-align: left;\n    margin-bottom: 50px;\n  }\n\n  .timeline-section h3 {\n    font-size: 0.75rem;\n    font-weight: 800;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.55);\n    margin-bottom: 20px;\n  }\n\n  .timeline-list {\n    list-style: none;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  .timeline-list li {\n    display: flex;\n    align-items: center;\n    padding: 16px 20px;\n    background: rgba(255,255,255,0.04);\n    border-left: 3px solid var(--accent-red);\n    font-size: 0.95rem;\n    color: rgba(255,255,255,0.75);\n    line-height: 1.4;\n  }\n\n  .timeline-list li strong {\n    color: #fff;\n    font-weight: 800;\n    margin-right: 5px;\n  }\n\n  /* ===== PROCESS GRID ===== */\n  .spec-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1px;\n    background: rgba(255,255,255,0.08);\n    margin-bottom: 50px;\n    border: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .spec-item {\n    padding: 26px 20px;\n    text-align: left;\n    background: var(--nike-grey);\n    transition: background 0.2s ease;\n  }\n\n  .spec-item:hover { background: #1a1a1a; }\n\n  .spec-item span {\n    display: block;\n    font-size: 0.7rem;\n    font-weight: 800;\n    color: rgba(255,255,255,0.45);\n    margin-bottom: 10px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .spec-item p {\n    font-size: 0.9rem;\n    font-weight: 800;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .spec-item .spec-desc {\n    font-size: 0.78rem;\n    font-weight: 400;\n    color: rgba(255,255,255,0.45);\n    margin-top: 5px;\n    text-transform: none;\n    line-height: 1.35;\n  }\n\n  /* ===== CONTACT NOTE ===== */\n  .contact-note {\n    border: 1px solid rgba(255,255,255,0.12);\n    padding: 22px 24px;\n    text-align: left;\n    margin-bottom: 50px;\n    display: flex;\n    align-items: flex-start;\n    gap: 16px;\n  }\n\n  .contact-note i {\n    color: var(--accent-red);\n    font-size: 1.1rem;\n    margin-top: 2px;\n    flex-shrink: 0;\n  }\n\n  .contact-note p {\n    font-size: 0.88rem;\n    color: rgba(255,255,255,0.6);\n    line-height: 1.5;\n  }\n\n  .contact-note p strong {\n    color: #fff;\n    font-weight: 800;\n  }\n\n  /* ===== SOCIAL & FOOTER ===== */\n  .social-section {\n    padding-top: 40px;\n    border-top: 1px solid rgba(255,255,255,0.1);\n    text-align: center;\n  }\n\n  .social-section p {\n    font-size: 0.75rem;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.45);\n    margin-bottom: 16px;\n  }\n\n  .instagram-link {\n    display: inline-flex;\n    align-items: center;\n    color: #fff;\n    text-decoration: none;\n    font-weight: 800;\n    font-size: 1.1rem;\n    letter-spacing: -0.01em;\n    transition: color 0.2s ease;\n  }\n\n  .instagram-link i { margin-right: 10px; color: var(--accent-red); }\n  .instagram-link:hover { color: rgba(255,255,255,0.7); }\n\n  /* ===== FOOTER ===== */\n  .footer {\n    background: var(--bg-white);\n    padding: 42px 20px 70px;\n    text-align: center;\n  }\n\n  .footer .back-home {\n    display: inline-block;\n    color: var(--text-grey);\n    font-size: 0.8rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  .footer .back-home:hover { color: #000; }\n\n  @media (max-width: 768px) {\n    .hero h1 { font-size: 4rem; }\n    .main-card { padding: 52px 22px; }\n    .spec-grid { grid-template-columns: repeat(2, 1fr); }\n    .timeline-list li { flex-direction: column; align-items: flex-start; gap: 4px; }\n  }\n\n  @media (max-width: 480px) {\n    .spec-grid { grid-template-columns: 1fr; }\n  }\n</style>\n<header class=\"hero\">\n<div class=\"status-badge\">Request received</div>\n<h1>You&rsquo;re in.</h1>\n<h3>Your team details are with us. Our designers are already on it.</h3>\n</header>\n<section class=\"dark-section\">\n<div class=\"activation-container\">\n<div class=\"main-card\">\n<p class=\"lead\">We&rsquo;ll reach out to confirm your request details and send your mockups. Keep an eye on your inbox &mdash; great things take a few days.</p>\n<div class=\"timeline-section\">\n<h3>What happens next</h3>\n<ul class=\"timeline-list\">\n<li><span><span style=\"font-size: 15.2px;\">We'll reach out within 24h to get a <strong>feel for your direction</strong> (check your mailbox!)</span></span></li>\n<li><span>Your design arrives in <strong>24&ndash;48 hours</strong></span></li>\n<li><span><strong>Revisions</strong> included until it's right</span></li>\n<li><span>Love it? We'll send your <strong>production quote</strong></span></li>\n</ul>\n</div>\n<div class=\"spec-grid uppercase\">\n<div class=\"spec-item\"><span>Confirmed</span>\n<p>&euro;15 deposit</p>\n<p class=\"spec-desc\">Credited in full to orders of 5+ jerseys.</p>\n</div>\n<div class=\"spec-item\"><span>Included</span>\n<p>Visual Identity</p>\n<p class=\"spec-desc\">Crest &amp; colours, fully integrated.</p>\n</div>\n<div class=\"spec-item\"><span>Transparent</span>\n<p>Final Quote</p>\n<p class=\"spec-desc\">Your exact order cost. No surprises.</p>\n</div>\n<div class=\"spec-item\"><span>Included</span>\n<p>Revisions</p>\n<p class=\"spec-desc\">We refine it until it&rsquo;s right.</p>\n</div>\n</div>\n<div class=\"contact-note\"><i class=\"fas fa-envelope\"></i>\n<p><strong>We&rsquo;ll reach you by email.</strong> If you don&rsquo;t hear from us within 24h, check your spam or promotions folder &mdash; we&rsquo;re in there.</p>\n</div>\n<div class=\"social-section\">\n<p>While you wait, get inspired</p>\n<a href=\"https://www.instagram.com/momutofc\" target=\"_blank\" rel=\"noopener\" class=\"instagram-link\"> <i class=\"fab fa-instagram\"></i>@momutofc </a></div>\n</div>\n</div>\n</section>\n<section class=\"footer\"><a href=\"/\" class=\"back-home\">Back to home</a></section>",
