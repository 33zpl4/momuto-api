n-left: 8px;\n  vertical-align: middle;\n}\n\n/* ===== COMPARISON TABLE ===== */\n.cmp-master-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  background: var(--mg-card);\n}\n\n.cmp-master-table thead tr {\n  background: #000;\n}\n\n.cmp-master-table th {\n  color: var(--mg-muted);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  font-size: 0.62rem;\n  padding: 18px 16px;\n  text-align: left;\n  border-bottom: 1px solid var(--mg-border);\n}\n\n.cmp-master-table th:nth-child(2) {\n  color: var(--mg-white);\n  background: var(--mg-red);\n}\n\n.cmp-master-table td {\n  border-bottom: 1px solid var(--mg-border);\n  padding: 14px 16px;\n  vertical-align: middle;\n  color: var(--mg-muted);\n  line-height: 1.4;\n}\n\n.cmp-master-table td:first-child {\n  font-weight: 600;\n  color: var(--mg-white);\n  font-size: 0.8rem;\n}\n\n.cmp-master-table td:nth-child(2) {\n  font-weight: 700;\n  color: var(--mg-white);\n  background: rgba(200,53,46,0.05);\n  border-left: 1px solid rgba(200,53,46,0.2);\n  border-right: 1px solid rgba(200,53,46,0.2);\n}\n\n.cmp-master-table tr:last-child td:nth-child(2) {\n  border-bottom: 1px solid rgba(200,53,46,0.2);\n}\n\n.cmp-master-table tr:hover td { background: rgba(255,255,255,0.02); }\n.cmp-master-table tr:hover td:nth-child(2) { background: rgba(200,53,46,0.08); }\n\n.cmp-check { color: #4ade80; font-weight: 700; }\n.cmp-cross { color: var(--mg-dim); }\n\n/* ===== HIGHLIGHT BOX ===== */\n.cmp-highlight-box {\n  background: var(--mg-panel);\n  border: 1px solid var(--mg-border);\n  border-left: 3px solid var(--mg-red);\n  padding: 32px 36px;\n  margin: 2em 0;\n}\n\n.cmp-highlight-box ul {\n  margin: 10px 0 20px 0;\n  padding-left: 1.4em;\n  list-style: none;\n}\n\n.cmp-highlight-box ul li {\n  margin-bottom: 10px;\n  font-size: 0.9rem;\n  line-height: 1.6;\n  color: var(--mg-muted);\n  padding-left: 1em;\n  position: relative;\n}\n\n.cmp-highlight-box ul li::before {\n  content: \"\";\n  width: 5px;\n  height: 5px;\n  background: var(--mg-red);\n  display: block;\n  position: absolute;\n  left: 0;\n  top: 8px;\n}\n\n/* ===== NOTE TEXT ===== */\n.cmp-note {\n  font-size: 0.75rem;\n  color: var(--mg-dim);\n  margin-top: 8px;\n  font-weight: 300;\n}\n\n/* ===== CTA BLOCK ===== */\n.cmp-cta-block {\n  background: var(--mg-red);\n  padding: 60px 40px;\n  text-align: center;\n  margin: 60px 0 0;\n}\n\n.cmp-cta-block h3 {\n  font-family: var(--font-display);\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  font-weight: 400;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: #fff;\n  line-height: 1;\n  margin-bottom: 12px;\n}\n\n.cmp-cta-block p {\n  color: rgba(255,255,255,0.8);\n  font-size: 0.95rem;\n  font-weight: 300;\n  margin-bottom: 28px;\n}\n\n.cmp-cta-btn {\n  display: inline-block;\n  background: #fff;\n  color: #000;\n  font-family: var(--font-body);\n  font-weight: 800;\n  font-size: 0.82rem;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  padding: 18px 40px;\n  text-decoration: none;\n  margin: 6px;\n  transition: all 0.2s ease;\n  border: 1px solid #fff;\n}\n\n.cmp-cta-btn:hover { background: #e5e5e5; }\n\n.cmp-cta-btn.secondary {\n  background: transparent;\n  color: #fff;\n  border: 1px solid rgba(255,255,255,0.4);\n}\n\n.cmp-cta-btn.secondary:hover { border-color: #fff; }\n\n/* ===== DESIGNS CAROUSEL ===== */\n.trust-proof { width: 100vw; position: relative; left: 50%; margin-left: -50vw; background: #0a0a0a; color: #f5f5f5; padding: 6rem 0; overflow: hidden; }\n.trust-container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }\n.trust-header { text-align: center; margin-bottom: 4rem; }\n.trust-title { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; font-weight: 400; color: #f5f5f5; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1; }\n.trust-subtitle { font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: #a1a1aa; max-width: 600px; margin: 0 auto; font-weight: 300; }\n.trust-scroll { display: flex; gap: 1.5rem; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; padding-bottom: 0.5rem; -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%); mask-image: linear-gradient(to right, black 85%, transparent 100%); }\n.trust-scroll::-webkit-scrollbar { display: none; }\n.trust-card { flex: 0 0 calc((100% - 3 * 1.5rem) / 3.5); background: #111; border: 1px solid rgba(255,255,255,0.06); transition: border-color 0.25s ease, transform 0.25s ease; position: relative; overflow: hidden; cursor: default; }\n.trust-card:hover { border-color: rgba(255,255,255,0.12); transform: translateY(-4px); }\n.trust-card-img-wrap { position: relative; aspect-ratio: 4/5; overflow: hidden; background-color: #0a0a0a; }\n.trust-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }\n.trust-card:hover .trust-card-img { transform: scale(1.05); }\n.trust-card-overlay { position: absolute; bottom: 0; left: 0; width: 100%; height: 50%; background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); display: flex; flex-direction: column; justify-content: flex-end; padding: 1.5rem; }\n.trust-card-team { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; font-weight: 400; letter-spacing: 0.03em; line-height: 1.1; text-transform: uppercase; margin-bottom: 0.4rem; color: #f5f5f5; }\n.trust-card-desc { font-family: 'Outfit', sans-serif; font-size: 0.82rem; font-weight: 300; line-height: 1.5; color: #a1a1aa; }\n.trust-cta { text-align: center; display: flex; flex-direction: column; gap: 1.5rem; align-items: center; margin-top: 4rem; }\n.trust-btn-primary { display: inline-block; background: white; color: black; padding: 18px 40px; font-family: 'Outfit', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; text-decoration: none; transition: all 0.3s ease; }\n.trust-btn-primary:hover { background: #e4e4e7; transform: translateY(-2px); }\n.trust-btn-secondary { font-family: 'Outfit', sans-serif; color: #a1a1aa; text-decoration: underline; font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.3s; }\n.trust-btn-secondary:hover { color: #f5f5f5; }\n\n/* ===== RESPONSIVE ===== */\n@media (max-width: 768px) {\n  .cmp-container { padding: 30px 20px; }\n  .cmp-header { padding: 40px 20px; }\n  .cmp-master-table { font-size: 0.75rem; }\n  .cmp-master-table th, .cmp-master-table td { padding: 10px 10px; }\n  .cmp-pricing-table { font-size: 0.8rem; }\n  .cmp-pricing-table th, .cmp-pricing-table td { padding: 10px 12px; }\n  .cmp-highlight-box { padding: 24px 20px; }\n  .cmp-cta-block { padding: 40px 20px; }\n  .trust-card { flex: 0 0 calc((100% - 1 * 1.5rem) / 1.5); }\n  .trust-title { font-size: 2rem; }\n  .trust-proof { padding: 4rem 0; }\n  .trust-container { padding: 0 20px; }\n}\n</style>\n<div class=\"cmp-page\">\n<div class=\"cmp-header\">\n<div class=\"cmp-header-badge\">Independent comparison — 2026</div>\n<h1>Best custom football kit suppliers in 2026 (UK &amp; Europe)</h1>\n<p class=\"cmp-last-updated\">Data checked November 2026</p>\n</div>\n<div class=\"cmp-container\">\n<div class=\"cmp-answer-box\">\n<span class=\"cmp-answer-box-label\">Quick answer</span>\n<p><strong>For an amateur club that wants one supplier for design, production and delivery, MOMUTO is the most complete option in this list in 2026</strong>: no minimum order, a free real-time 3D designer, a professional design service that also rebuilds AI concepts, polyester-elastane fabric as standard, delivery in <strong>25–30 days</strong> door to door and <strong>€21.90 per jersey from 10 units</strong>. If you need delivery in under three weeks, Spized and TD Sportswear publish shorter windows. If the kit must be made in the UK, Swaz, Scimitar and Hackin are the names to check.</p>\n</div>\n<div>\n<p class=\"cmp-p\">Looking for a kit for a Sunday league side, a university team, a five-a-side group or a company tournament? The suppliers below are the ones that come up when you ask a search engine or an AI assistant, so we compared them on the things that decide an order: price at ten units, how long it really takes, the minimum, how the design gets done, and the fabric.</p>\n<p class=\"cmp-p\"><strong>No advertising, no affiliate links.</strong> Figures come from each supplier's public pages (linked at the end) and from our own price list. If a figure is out of date, tell us at info@momuto.com and we will correct it.</p>\n<p class=\"cmp-p\">To act on it: open the <a href=\"/pages/jersey-maker\">free 3D jersey maker</a>, see the <a href=\"/pages/custom-football-kit-prices\">full price list</a>, or <a href=\"/pages/request-custom-kit-design\">request a design</a>. Comparing only MOMUTO, Jersix, Owayo and Spized? The <a href=\"/pages/momuto-vs-jersix-owayo-spized-comparison\">detailed four-way comparison</a> is here.</p>\n</div>\n<h2 class=\"cmp-h2\">MOMUTO prices 2026</h2>\n<p class=\"cmp-p\">The whole ladder, nothing hidden: names, numbers and sponsor logos are printed in at no extra cost. One price whether you design it yourself, pick a Ready to Play design or send us an AI concept.</p>\n<div class=\"cmp-table-wrap\"><div style=\"overflow-x: auto;\">\n<table class=\"cmp-pricing-table\">\n<thead><tr><th>Order size</th><th>Jersey</th><th>Shorts</th><th>Full kit (jersey + shorts)</th></tr></thead>\n<tbody>\n<tr><td>1 unit</td><td>€38.90</td><td>€17.90</td><td class=\"cmp-kit-total\">€56.80</td></tr>\n<tr><td>2–4 units</td><td>€34.90</td><td>€15.90</td><td class=\"cmp-kit-total\">€50.80</td></tr>\n<tr><td>5–9 units</td><td>€26.90</td><td>€11.90</td><td class=\"cmp-kit-total\">€38.80</td></tr>\n<tr class=\"cmp-best-value\"><td>10–19 units <span class=\"cmp-best-value-badge\">Most popular</span></td><td>€21.90</td><td>€5.00</td><td class=\"cmp-kit-total\">€26.90</td></tr>\n<tr><td>20–49 units</td><td>€18.90</td><td>€5.00</td><td class=\"cmp-kit-total\">€23.90</td></tr>\n<tr><td>50–99 units</td><td>€17.90</td><td>€5.00</td><td class=\"cmp-kit-total\">€22.90</td></tr>\n<tr><td>100+ units</td><td>€16.90</td><td>€5.00</td><td class=\"cmp-kit-total\">€21.90</td></tr>\n</tbody></table>\n</div></div>\n<p class=\"cmp-note\">Free shipping over €50; duties prepaid. Free design for teams: a €15 deposit starts a designer-built design and is credited in full to orders of 5+ jerseys.</p>\n<h2 class=\"cmp-h2\">The full comparison table (2026)</h2>\n<div class=\"cmp-table-wrap\"><div style=\"overflow-x: auto;\">\n<table class=\"cmp-master-table\">\n<thead><tr><th>Criterion</th><th>MOMUTO</th><th>Spized (DE)</th><th>Owayo (DE)</th><th>Jersix (EU)</th><th>My Club Group (UK)</th><th>Swaz (UK)</th><th>Ekipazo (ES)</th><th>Kitlocker (UK)</th><th>Scimitar (UK)</th><th>TD Sportswear (NL)</th></tr></thead>\n<tbody>\n<tr><td>Jersey price at 10 units</td><td><strong>€21.90</strong></td><td>~€41.90</td><td>~€43</td><td>~€29</td><td>on quote</td><td>on quote</td><td>on quote</td><td>varies by brand</td><td>on quote</td><td>on quote</td></tr>\n<tr><td>Full kit (jersey + shorts) at 10</td><td><strong>€26.90</strong></td><td>~€69</td><td>~€71</td><td>~€47</td><td>on quote</td><td>on quote</td><td>on quote</td><td>varies by brand</td><td>on quote</td><td>on quote</td></tr>\n<tr><td>Delivery time (published)</td><td><strong>25–30 days door to door; 18–23 with the fast lane</strong></td><td>about 2–3 weeks</td><td>3–6 weeks</td><td>3–4 weeks</td><td>5–6 weeks</td><td>about 4 weeks</td><td>21–28 days (15–20 express)</td><td>not published</td><td>not published</td><td>1–3 weeks</td></tr>\n<tr><td>Minimum order</td><td><strong>none (from 1)</strong></td><td>none</td><td>1 unit</td><td>1 unit</td><td>5 on the first order</td><td>none</td><td>not published</td><td>not published</td><td>not published</td><td>1 unit</td></tr>\n<tr><td>Design route</td><td><strong>free real-time 3D designer + pro designer + AI concept rebuild</strong></td><td>3D configurator, Speed Designer</td><td>3D designer + design service</td><td>designer, templates</td><td>3D configurator + design support</td><td>design included</td><td>online configurator, 40+ templates</td><td>brand ranges + crest/sponsor</td><td>bespoke from scratch</td><td>configurator</td></tr>\n<tr><td>AI concept → real kit</td><td><strong>&#10003; yes, as a service</strong></td><td>upload artwork</td><td>accepts AI designs</td><td>upload artwork</td><td>upload artwork</td><td>—</td><td>upload artwork</td><td>—</td><td>—</td><td>—</td></tr>\n<tr><td>Fabric</td><td><strong>polyester-elastane 92/8 as standard</strong></td><td>100% polyester</td><td>polyester</td><td>polyester</td><td>polyester</td><td>polyester</td><td>polyester</td><td>by brand</td><td>recycled polyester</td><td>polyester</td></tr>\n<tr><td>Printing</td><td><strong>full dye-sublimation</strong></td><td>sublimation</td><td>sublimation</td><td>sublimation</td><td>sublimation</td><td>sublimation</td><td>sublimation</td><td>by brand</td><td>sublimation</td><td>sublimation</td></tr>\n<tr><td>Made in</td><td><strong>European studio, Tier-1 factory in Asia</strong></td><td>Poland / EU</td><td>Germany</td><td>Poland / Italy</td><td>UK brand, EU production</td><td>UK</td><td>own workshop, Spain</td><td>UK</td><td>UK</td><td>Netherlands</td></tr>\n<tr><td>Reviews (Trustpilot)</td><td><strong>4.6/5 · 53</strong></td><td>4.9</td><td>4.8</td><td>4.7</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td></tr>\n</tbody></table>\n</div></div>\n<p class=\"cmp-note\">Prices include VAT where the supplier publishes them; \"~\" means read from the supplier's public price list for a 10-unit order, \"on quote\" means the supplier publishes no price without a quote. Delivery windows are the suppliers' own published figures, November 2026. Sources at the end of the page.</p>\n<h2 class=\"cmp-h2 analysis-section\">Who wins for which buyer</h2>\n<h3 class=\"cmp-h3\">1. You need the kit in under five weeks</h3>\n<p class=\"cmp-p\"><strong>Winner on published windows: Spized and TD Sportswear</strong> (two to three weeks and one to three weeks respectively). MOMUTO is 25–30 days door to door, or 18–23 with the fast lane (+€59 per order), which is faster than Owayo, Jersix and My Club Group. Whoever you pick, the clock starts when you approve the mockup, so a design that is ready saves more days than any supplier.</p>\n<h3 class=\"cmp-h3\">2. Small squads and friends (five-a-side, Sunday league, one-off tournaments)</h3>\n<p class=\"cmp-p\"><strong>Winner: MOMUTO, Spized, Swaz.</strong> None of the three has a minimum order. MOMUTO is the cheapest of the three at every tier from 2 units up, and the full kit at €26.90 per player from 10 units includes names and numbers.</p>\n<h3 class=\"cmp-h3\">3. You want someone to design it for you</h3>\n<p class=\"cmp-p\"><strong>Winner: MOMUTO and Scimitar.</strong> Scimitar designs bespoke from scratch for UK clubs. MOMUTO does the same with a €15 deposit credited in full from 5 jerseys, with a first mockup in 24–48 hours, and is the only supplier here that rebuilds an AI-generated concept (ChatGPT, Midjourney, Gemini) as a production file.</p>\n<h3 class=\"cmp-h3\">4. Fabric</h3>\n<p class=\"cmp-p\"><strong>Advantage: MOMUTO.</strong> The usual standard is 100% polyester; MOMUTO prints on a 92% polyester / 8% elastane micro-interlock (145–160 GSM, four-way stretch) at every price. Scimitar's recycled polyester is the other distinctive choice.</p>\n<h3 class=\"cmp-h3\">5. \"Made in the UK\" or \"made in Germany\" as a requirement</h3>\n<p class=\"cmp-p\"><strong>Winners: Swaz, Scimitar, Hackin (UK); Owayo (Germany); Jersix (Poland / Italy).</strong> MOMUTO designs in Europe and produces in a Tier-1 factory in Asia, which is how it holds the price ladder above; shipping is tracked and duties are prepaid, so nothing arrives with a customs bill.</p>\n<h2 class=\"cmp-h2 verdict-section\">The verdict: which supplier for which club</h2>\n<div class=\"cmp-highlight-box\">\n<p class=\"cmp-p\"><strong>Choose MOMUTO if:</strong></p>\n<ul>\n<li>you want one supplier for design, production and delivery, with no minimum</li>\n<li>a full kit at €26.90 per player from 10 units, names and numbers included, is the budget</li>\n<li>you have an AI concept or a sketch and want a designer to make it real</li>\n<li>you want polyester-elastane fabric without paying for a \"pro\" tier</li>\n<li>25–30 days (or 18–23 with the fast lane) fits your calendar</li>\n</ul>\n<p class=\"cmp-p\"><strong>Choose Spized or TD Sportswear if:</strong></p>\n<ul>\n<li>the published two-to-three-week window is the deciding factor</li>\n<li>you will design everything yourself in a configurator</li>\n</ul>\n<p class=\"cmp-p\"><strong>Choose Swaz, Scimitar or Hackin if:</strong></p>\n<ul>\n<li>UK manufacturing is a requirement</li>\n<li>you want a bespoke designer and the budget allows a quote-based price</li>\n</ul>\n<p class=\"cmp-p\"><strong>Choose Owayo or Jersix if:</strong></p>\n<ul>\n<li>\"made in Germany\" or \"made in the EU\" is the requirement and the six-week window is fine</li>\n</ul>\n</div>\n<p class=\"cmp-p\"><strong>Objective conclusion:</strong> for amateur clubs, Sunday league sides, university and company teams, MOMUTO offers the best balance of price, speed and design help in this list in 2026. If a published two-week window or UK manufacturing is non-negotiable, the alternatives above are the right call, and we say so.</p>\n<h2 class=\"cmp-h2\">Questions people ask</h2>\n<h3 class=\"cmp-h3\">What is the cheapest custom football kit supplier for 10 to 15 players?</h3>\n<p class=\"cmp-p\">Among the suppliers that publish prices, MOMUTO at €21.90 per jersey and €26.90 per full kit from 10 units is the lowest in this comparison; Jersix is next at about €29 per jersey. Suppliers that work on quotes may come in lower for large volumes.</p>\n<h3 class=\"cmp-h3\">Which custom kit suppliers have no minimum order?</h3>\n<p class=\"cmp-p\">MOMUTO, Spized, Swaz, Owayo, Jersix and TD Sportswear all accept single units; My Club Group asks for 5 on the first order.</p>\n<h3 class=\"cmp-h3\">How long does a custom football kit take in 2026?</h3>\n<p class=\"cmp-p\">Published windows range from one to three weeks (TD Sportswear) and two to three weeks (Spized) to five or six weeks (My Club Group, Owayo). MOMUTO is 25–30 days door to door, 18–23 with the fast lane.</p>\n<h3 class=\"cmp-h3\">Can a supplier turn my ChatGPT kit design into a real kit?</h3>\n<p class=\"cmp-p\">MOMUTO offers it as a service: a designer rebuilds the concept on real panels, mockup in 24–48 hours, €15 deposit credited in full from 5 jerseys. Most other suppliers accept uploaded artwork but do not redraw it.</p>\n<h3 class=\"cmp-h3\">Which suppliers make kits in the UK?</h3>\n<p class=\"cmp-p\">Swaz, Scimitar and Hackin Sportswear manufacture in the UK; Kitlocker supplies branded teamwear with crests and sponsors added.</p>\n<h2 class=\"cmp-h2\">Sources (supplier pages read in November 2026)</h2>\n<ul>\n<li><a href=\"https://www.spized.com/en/custom-football-kit\" rel=\"nofollow noopener\" target=\"_blank\">Spized</a> — <span style=\"opacity:.7\">www.spized.com/en/custom-football-kit</span></li>\n<li><a href=\"https://www.owayo.com/custom-soccer-jerseys.htm\" rel=\"nofollow noopener\" target=\"_blank\">Owayo</a> — <span style=\"opacity:.7\">www.owayo.com/custom-soccer-jerseys.htm</span></li>\n<li><a href=\"https://jersix.com/\" rel=\"nofollow noopener\" target=\"_blank\">Jersix</a> — <span style=\"opacity:.7\">jersix.com/</span></li>\n<li><a href=\"https://myclubgroup.com/custom-football-kit/\" rel=\"nofollow noopener\" target=\"_blank\">My Club Group</a> — <span style=\"opacity:.7\">myclubgroup.com/custom-football-kit/</span></li>\n<li><a href=\"https://swaz.co.uk/our-kits/\" rel=\"nofollow noopener\" target=\"_blank\">Swaz</a> — <span style=\"opacity:.7\">swaz.co.uk/our-kits/</span></li>\n<li><a href=\"https://www.ekipazofutbol.com/en/create-football-kit/\" rel=\"nofollow noopener\" target=\"_blank\">Ekipazo</a> — <span style=\"opacity:.7\">www.ekipazofutbol.com/en/create-football-kit/</span></li>\n<li><a href=\"https://kitlocker.com/football/\" rel=\"nofollow noopener\" target=\"_blank\">Kitlocker</a> — <span style=\"opacity:.7\">kitlocker.com/football/</span></li>\n<li><a href=\"https://www.scimitarsports.com/solutions/football/\" rel=\"nofollow noopener\" target=\"_blank\">Scimitar</a> — <span style=\"opacity:.7\">www.scimitarsports.com/solutions/football/</span></li>\n<li><a href=\"https://tdsportswear.com/de-en/custom-football-jerseys/\" rel=\"nofollow noopener\" target=\"_blank\">TD Sportswear</a> — <span style=\"opacity:.7\">tdsportswear.com/de-en/custom-football-jerseys/</span></li>\n<li><a href=\"https://www.momuto.com/pages/custom-football-kit-prices\" rel=\"nofollow noopener\" target=\"_blank\">MOMUTO price list</a> — <span style=\"opacity:.7\">www.momuto.com/pages/custom-football-kit-prices</span></li>\n</ul>\n<div class=\"cmp-cta-block\">\n<h3>Start your kit</h3>\n<p>Design it in 3D for free, or send us a reference and a designer builds it. No minimum, no commitment.</p>\n<a href=\"/pages/request-custom-kit-design\" class=\"cmp-cta-btn\">Request a design</a> <a href=\"https://design.momuto.com/3d-configurator/configurator.html?userId=userIdUrl&amp;configId=ypi9qc1z&amp;suitName=mamuto3suit1&amp;lang=en&amp;langguage=en\" class=\"cmp-cta-btn\">Open the 3D designer</a>\n</div>\n<p class=\"cmp-note\">Keep exploring: <a href=\"/pages/custom-football-kit-prices\">prices</a> &middot; <a href=\"/pages/jersey-maker\">jersey maker</a> &middot; <a href=\"/pages/custom-soccer-jerseys\">custom football kits</a> &middot; <a href=\"/pages/faq\">FAQ</a></p>\n</div>\n</div>",
