<script>
$(document).ready(function(){
    // Toggle between adult and kids charts
    $('.toggle-option').click(function() {
        const target = $(this).data('target');
        
        // Update toggle buttons
        $('.toggle-option').removeClass('active');
        $(this).addClass('active');
        
        // Show/hide charts
        $('.chart-container').removeClass('active');
        $(`#${target}-chart`).addClass('active');
    });
    
    // Mobile responsive text changes
    if ($(window).width() < 600) {
        $('.jersey-table th:nth-of-type(3)').text('Weight (kg)');
        $('.jersey-table th:nth-of-type(4)').text('Height (cm)');
        $('.shorts-table th:nth-of-type(3)').text('Hips (cm)');
        $('.shorts-table th:nth-of-type(4)').text('Height (cm)');
    }
});
</script>
