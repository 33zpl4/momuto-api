<script>
(function() {
  var params = new URLSearchParams(window.location.search);
  var isPaid = params.get('paid') === 'true';
  if (isPaid) {
    var pb = document.getElementById('paidBanner'); if (pb) pb.style.display = 'block';
    var pg = document.getElementById('concept-transform') || document.getElementById('payment-gate'); if (pg) pg.style.display = 'none';
    var bf = document.getElementById('brief-form-section'); if (bf) bf.style.display = 'block';
    setTimeout(function() {
      var f = document.getElementById('cta-form'); if (f) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 300);
  }
  // Gate: require a valid email, capture it as a lead (best-effort), then go to Stripe
  var gateEmail = document.getElementById('gateEmail');
  var gatePayBtn = document.getElementById('gatePayBtn');
  var baseStripeUrl = 'https://buy.stripe.com/4gM4gzga82i04vletD3wQ0i';
  if (gateEmail && gatePayBtn) {
    var validEmail = function (v) { return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test((v || '').trim()); };
    var setReady = function (on) {
      gatePayBtn.classList.toggle('is-disabled', !on);
      gatePayBtn.setAttribute('aria-disabled', on ? 'false' : 'true');
      gatePayBtn.href = on
        ? baseStripeUrl + '?prefilled_email=' + encodeURIComponent(gateEmail.value.trim())
        : baseStripeUrl;
    };
    setReady(false);
    gateEmail.addEventListener('input', function () { setReady(validEmail(this.value)); });
    gatePayBtn.addEventListener('click', function (e) {
      var email = gateEmail.value.trim();
      e.preventDefault();
      if (!validEmail(email)) { gateEmail.focus(); return; }
      var navigated = false;
      var go = function () {
        if (navigated) return; navigated = true;
        window.location.href = baseStripeUrl + '?prefilled_email=' + encodeURIComponent(email);
      };
      var locale = (location.hostname.match(/^(es|fr|it)\./) || [])[1] || 'en';
      try {
        fetch('https://momuto-api.vercel.app/api/lead', {
          method: 'POST', keepalive: true,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, locale: locale, source: window.location.href })
        }).then(go, go);
      } catch (_) { go(); }
      setTimeout(go, 1200); // safety: never trap the user
    });
  }
  // Studio path-card CTA → smooth-scroll to the gate
  var studioCta = document.getElementById('studioPathCta');
  if (studioCta) {
    studioCta.addEventListener('click', function(e) {
      e.preventDefault();
      var pg = document.getElementById('concept-transform') || document.getElementById('payment-gate'); if (pg) pg.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
})();
</script>
