        const galleryGrid = document.getElementById('galleryGrid');
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        let itemsToShow = 9;

        function renderGallery() {
            galleryGrid.innerHTML = '';

            designs.slice(0, itemsToShow).forEach(design => {
                const card = document.createElement(design.url ? 'a' : 'div');
                card.className = 'design-card';
                if (design.url) { card.href = design.url; }

                card.innerHTML = `
    <div class="card-image-wrapper">
        <span class="card-tag">Calcio</span>
        <img src="${design.image}" alt="Kit ${design.team}" class="card-img" loading="lazy">
        <div class="card-overlay">
            <h3 class="card-team">${design.team}</h3>
            <p class="card-desc">${design.desc}</p>
        </div>
    </div>
`;
                galleryGrid.appendChild(card);
            });

            if (itemsToShow >= designs.length) {
                loadMoreBtn.style.display = 'none';
            }
        }

        loadMoreBtn.addEventListener('click', () => {
            itemsToShow += 6;
            renderGallery();
        });

        renderGallery();
    </script>
